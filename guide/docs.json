{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Hivemind",
  "description": "A workspace for coding agents: run them side by side, see which one waits on you, and drive them from other computers, your phone or your own program.",
  "colors": {
    "primary": "#3C68D9",
    "light": "#739BF5",
    "dark": "#2C57CD"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0D0E10"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started",
              "run-many-agents",
              "docs-for-agents"
            ]
          }
        ]
      },
      {
        "tab": "Use Hivemind",
        "groups": [
          {
            "group": "Agents",
            "pages": [
              "agents",
              "know-who-is-waiting",
              "agent-workflows",
              "review",
              "issues",
              "git-worktree",
              "views"
            ]
          },
          {
            "group": "Other computers and people",
            "pages": [
              "self-hosting",
              "machines",
              "host",
              "connect",
              "multiplayer",
              "phone",
              "browser-tab"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "appearance"
            ]
          }
        ]
      },
      {
        "tab": "Concepts",
        "groups": [
          {
            "group": "Concepts",
            "pages": [
              "workspaces",
              "agent-states",
              "plugins",
              "how-devices-connect",
              "security-and-privacy"
            ]
          }
        ]
      },
      {
        "tab": "Extend",
        "groups": [
          {
            "group": "Extend",
            "pages": [
              "widgets",
              "extension-authoring",
              "tool-plugins",
              "agent-providers",
              "publish-to-hivehub"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api",
              "api-tokens",
              "api-connect",
              "api-methods",
              "api-protocol"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "cli",
              "keyboard-shortcuts",
              "settings",
              "environment-variables",
              "agent-yaml",
              "hive-net",
              "glossary"
            ]
          }
        ]
      },
      {
        "tab": "Help",
        "groups": [
          {
            "group": "Help",
            "pages": [
              "troubleshooting",
              "faq",
              "logs-and-bug-reports",
              "changelog"
            ]
          },
          {
            "group": "Install and update",
            "pages": [
              "install",
              "system-requirements",
              "update-and-roll-back",
              "uninstall"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/dip497/hivemind"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://hivemind.griiken.com/download"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
