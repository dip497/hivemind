<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a move to a new phone: its files hold this phone's
     device key, and a copy would be a second phone answering as this one. A new phone pairs anew. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
