{
  "name": "@hivemind/cli",
  "version": "2026.9.6",
  "private": true,
  "type": "module",
  "bin": {
    "hive": "./dist/hive"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun build src/index.ts --compile --outfile=dist/hive-linux-x64 --target=bun-linux-x64 && bun build src/index.ts --compile --outfile=dist/hive-darwin-arm64 --target=bun-darwin-arm64 && bun build src/index.ts --compile --outfile=dist/hive-windows-x64.exe --target=bun-windows-x64",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hivemind/agent-host": "workspace:*",
    "@hivemind/agents": "workspace:*",
    "@hivemind/core": "workspace:*",
    "@hivemind/view-sdk": "workspace:*",
    "citty": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hivemind/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
