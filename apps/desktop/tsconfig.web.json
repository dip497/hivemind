{
  "extends": "@hivemind/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@hivemind/app-ui": ["./src/renderer/src/plugin-ui.ts"]
    },
    "outDir": "out/.tsc-web"
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/browser/**/*", "views/*/src/**/*", "tools/*/src/**/*"],
  "exclude": ["node_modules", "out", "dist"]
}
