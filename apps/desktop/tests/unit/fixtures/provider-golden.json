{
  "claude": {
    "identify": {
      "bare": "claude",
      "path": "claude"
    },
    "promptViaArgv": true,
    "spawn": {
      "cmd": "claude",
      "args": [
        "--settings",
        "<settings-json>",
        "--session-id",
        "<uuid>",
        "--dangerously-skip-permissions"
      ],
      "env": {
        "HIVE_AGENT_DEPTH": "1",
        "HIVE_HCP_SOCK": "/x/ud/hcp.sock",
        "HCP_TOKEN": "golden-token",
        "HIVEMIND_TILE": "tile-g",
        "HIVE_AGENT_ID": "claude"
      },
      "settings": {
        "hooks": {
          "SessionStart": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/tile-session-tracker.cjs' '/x/ud/tile-sessions'"
                }
              ]
            }
          ],
          "PreToolUse": [
            {
              "matcher": "ExitPlanMode",
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/plan-review-hook.cjs' '/x/ud/plan-bridge.sock'",
                  "timeout": 345600
                }
              ]
            }
          ],
          "Stop": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/hcp-stop-hook.cjs' '/x/ud/hcp.sock'",
                  "timeout": 10
                }
              ]
            }
          ],
          "SubagentStart": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/hcp-subagent-hook.cjs' '/x/ud/hcp.sock'",
                  "timeout": 10
                }
              ]
            }
          ],
          "SubagentStop": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/hcp-subagent-hook.cjs' '/x/ud/hcp.sock'",
                  "timeout": 10
                }
              ]
            }
          ],
          "Notification": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/hcp-notification-hook.cjs' '/x/ud/hcp.sock'",
                  "timeout": 10
                }
              ]
            }
          ],
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "HIVEMIND_TILE='tile-g' ELECTRON_RUN_AS_NODE=1 '/x/electron' '/x/ud/hcp-userprompt-hook.cjs' '/x/ud/hcp.sock'",
                  "timeout": 10
                }
              ]
            }
          ]
        }
      }
    },
