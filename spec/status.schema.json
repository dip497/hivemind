{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivemind.dev/spec/status/0.2.json",
  "title": "Agent status",
  "description": "A session's status: the fold of its events and host facts (status.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "subagents",
    "background",
    "compacting"
  ],
  "properties": {
    "state": {
      "enum": [
        "idle",
        "working",
        "waiting",
        "done",
        "failed",
        "interrupted",
        "limited",
        "exited"
      ]
    },
    "kind": {
      "enum": [
        "permission",
        "question",
        "plan",
        "approval",
        "other"
      ],
      "description": "Present only while waiting."
    },
    "subagents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "background": {
      "type": "integer",
      "minimum": 0
    },
    "awaiting": {
      "type": "integer",
      "minimum": 1,
      "description": "Its turn over and still working: the background tasks it waits to hear from. Absent otherwise."
    },
    "compacting": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "maxLength": 80,
      "description": "What the agent says it is doing, from its window title as its manifest reads it. Not part of the fold: the host sets it from the terminal, clears it when the agent says nothing or exits."
    }
  }
}
