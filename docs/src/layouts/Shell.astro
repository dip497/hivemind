---
/**
 * Chrome for the pages outside Starlight. The catalog pages share it so a plugin's detail
 * page is the same site as its listing — same nav, same theme key, same tokens.
 */
import "../styles/workspace.css";

interface Props { title: string; description: string; nav?: string }
const { title, description, nav } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}/${p}`;
const repo = "https://github.com/dip497/hivemind";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <!-- One theme, everywhere, set before paint: the product is a dark canvas and the site
       wears its palette. There is no picker to disagree with. -->
  <script is:inline>document.documentElement.dataset.theme = "dark";</script>

  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href={link("favicon.svg")} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="nav-in">
    <a class="brand" href={link("")} aria-label="Hivemind home">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M11.14 1.70 Q12 1.20 12.86 1.70 L16.51 3.80 Q17.37 4.30 17.37 5.29 L17.37 9.51 Q17.37 10.50 16.51 11 L12.86 13.10 Q12 13.60 11.14 13.10 L7.49 11 Q6.63 10.50 6.63 9.51 L6.63 5.29 Q6.63 4.30 7.49 3.80 Z" fill="currentColor" />
        <path d="M5.60 11.30 Q6.46 10.80 7.32 11.30 L10.97 13.40 Q11.83 13.90 11.83 14.89 L11.83 19.11 Q11.83 20.10 10.97 20.60 L7.32 22.70 Q6.46 23.20 5.60 22.70 L1.95 20.60 Q1.09 20.10 1.09 19.11 L1.09 14.89 Q1.09 13.90 1.95 13.40 Z" fill="currentColor" opacity=".4" />
        <path d="M16.68 11.30 Q17.54 10.80 18.40 11.30 L22.05 13.40 Q22.91 13.90 22.91 14.89 L22.91 19.11 Q22.91 20.10 22.05 20.60 L18.40 22.70 Q17.54 23.20 16.68 22.70 L13.03 20.60 Q12.17 20.10 12.17 19.11 L12.17 14.89 Q12.17 13.90 13.03 13.40 Z" fill="currentColor" opacity=".4" />
      </svg>
      Hivemind
    </a>
    <nav class="links" aria-label="Main">
      <a href={link("plugins/")} aria-current={nav === "plugins" ? "page" : undefined}>Plugins</a>
      <a href={link("guide/")}>Docs</a>
      <a href={repo}>GitHub</a>
    </nav>
    <a class="btn small" href={`${repo}/releases`}>Download</a>
  </div>
</header>

<main id="main"><slot /></main>

<footer class="foot">
  <div class="wrap">
    <p>Hivemind · <a href={repo}>GitHub</a> · <a href={link("guide/")}>Docs</a> · MIT</p>
  </div>
</footer>

<style is:global>
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg2);font-family:var(--f);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  ::selection{background:color-mix(in oklab,var(--brand) 40%,transparent)}
  :focus-visible{outline:2px solid var(--idle);outline-offset:3px;border-radius:3px}
  .skip{position:absolute;left:16px;top:-60px;background:var(--fg);color:var(--bg);padding:10px 14px;z-index:200;border-radius:5px}
  .skip:focus{top:12px}
  .wrap{max-width:var(--w);margin:0 auto;padding:0 28px}
  .wrap.narrow{max-width:820px}
  h1,h2,h3{color:var(--fg);margin:0;text-wrap:balance;letter-spacing:var(--tr-sub);font-weight:600}
  h1{font-size:var(--t-display);line-height:1.0;letter-spacing:var(--tr-display)}
  h2{font-size:var(--t-heading);line-height:1.06;letter-spacing:var(--tr-heading)}
  h3{font-size:15.5px;line-height:1.35}
  p{margin:0}
  code{font-family:var(--f-m)}
  .lede{font-size:clamp(16px,1.2vw,19px);line-height:1.55;color:var(--fg2);max-width:58ch;margin-top:18px}
  .sub{font-size:15px;line-height:1.6;color:var(--fg3);max-width:68ch;margin-top:10px}
  .eyebrow{font-family:var(--f-m);font-size:12px;letter-spacing:.04em;color:var(--fg3)}

  .nav{position:sticky;top:0;z-index:50;background:color-mix(in oklab,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
  .nav-in{max-width:var(--w);margin:0 auto;padding:0 28px;height:58px;display:flex;align-items:center;gap:24px}
  .brand{display:flex;align-items:center;gap:9px;font-weight:600;font-size:16px;color:var(--fg);text-decoration:none;letter-spacing:-.02em}
  .links{display:flex;gap:20px;margin-left:auto;font-size:14px}
  .links a{color:var(--fg3);text-decoration:none;transition:color var(--d2) ease}
  .links a[aria-current]{color:var(--fg)}
  @media (hover:hover) and (pointer:fine){ .links a:hover{color:var(--fg)} }
  .btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-weight:500;
    background:var(--fg);color:var(--bg);border:1px solid var(--fg);border-radius:6px;padding:9px 16px;
    transition-property:opacity,scale;transition-duration:var(--d2);transition-timing-function:ease}
  .btn.small{padding:6px 13px;font-size:13.5px}
  .btn:active{scale:.96;transition-duration:var(--d1);transition-timing-function:var(--ease)}
  @media (hover:hover) and (pointer:fine){ .btn:hover{opacity:.88} }

  .foot{border-top:1px solid var(--line);padding:30px 0;font-size:14px;color:var(--fg3);margin-top:72px}
  .foot a{color:var(--fg2);text-decoration:none}
  /* Phones: the nav becomes two rows, with the links on a strip that scrolls. */
  @media (max-width:640px){
    .nav-in{height:auto;min-height:54px;padding:9px 18px;flex-wrap:wrap;gap:10px 14px}
    .links{order:3;width:100%;margin-left:0;overflow-x:auto;gap:18px;scrollbar-width:none}
    .links::-webkit-scrollbar{display:none}
    .links a{white-space:nowrap}
    .nav-in > .btn{margin-left:auto}
  }
  @media (prefers-reduced-motion:reduce){ *{transition-duration:1ms !important} }
</style>
</body>
</html>
