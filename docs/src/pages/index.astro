---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path}`;
const title = 'Hivemind — a workspace for your coding agents';
const description =
  'A Linux workspace that runs coding-agent CLIs on one canvas, next to the terminals, editor and diffs they are working on. Local, open source, driven from the shell.';
const repo = 'https://github.com/dip497/hivemind';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#EDE8DB" />
  <link rel="icon" href={link('favicon.svg')} />
  <link rel="alternate" type="text/markdown" href={link('llms.txt')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<div class="page">

  <!-- ══════════ MASTHEAD ══════════ -->
  <header class="mast">
    <div class="l"><b>FREE</b><span>MIT · NO<br />ACCOUNT</span></div>
    <div class="m">
      <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="1.4" y="1.4" width="9.2" height="9.2" fill="currentColor" />
        <rect x="13.4" y="1.4" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width="2.2" />
        <rect x="1.4" y="13.4" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width="2.2" />
        <rect x="13.4" y="13.4" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width="2.2" />
      </svg>
      <span class="title">HIVEMIND</span>
    </div>
    <nav class="r" aria-label="Main">
      <a href={link('guide/')}>DOCS</a>
      <a href={link('guide/views/')}>VIEWS</a>
      <a href={repo}>GITHUB ↗</a>
    </nav>
  </header>

  <main id="main">

    <!-- ══════════ PAGE 1 ══════════ -->
    <div class="grid r-hero">
      <section class="panel">
        <div class="tone t1" aria-hidden="true"></div>
        <p class="cap">Page 1 · 23:40, one open branch</p>
        <div class="body pc">
          <h1>One of you.<br /><em>Eleven jobs.</em></h1>
          <p class="say">Hivemind runs coding-agent CLIs on one canvas, next to the terminals,
            editor and diffs they are working on. On your machine, with your keys.</p>
          <div class="btns">
            <a class="btn spot" href={`${repo}/releases`}>Download for Linux</a>
            <a class="btn" href="#how">How it works</a>
          </div>
          <p class="fine">NO CLOUD · NO ACCOUNT · MIT</p>
        </div>
      </section>

      <section class="panel">
        <div class="tone t2" aria-hidden="true"></div>
        <p class="cap">The desk</p>
        <div class="stack" aria-hidden="true">
          <div class="tile" style="left:4%;top:14%;width:66%;height:48%">
            <div class="bar">CLAUDE · API</div>
            <div class="rows"><b class="p">$ hive ctl read</b>
              <i style="width:88%"></i><i class="f" style="width:66%"></i>
              <i style="width:74%"></i><i class="f" style="width:52%"></i>
              <b class="p">$ pytest -q</b><i class="ok" style="width:40%"></i></div>
          </div>
          <div class="tile" style="left:32%;top:44%;width:64%;height:46%">
            <div class="bar">DIFF · LIMITS.TS</div>
            <div class="rows"><i class="add" style="width:78%"></i><i class="add" style="width:60%"></i>
              <i class="del" style="width:52%"></i><i style="width:70%"></i>
              <i class="f" style="width:44%"></i><i class="add" style="width:64%"></i></div>
          </div>
          <div class="tile" style="left:2%;top:66%;width:34%;height:28%">
            <div class="bar">SHELL</div>
            <div class="rows"><b class="p">$ git status</b><i class="f" style="width:62%"></i></div>
          </div>
        </div>
      </section>
    </div>

    <!-- ══════════ IMPACT FRAME ══════════ -->
    <div class="grid one">
      <section class="panel black impact-panel">
        <p class="cap">2 · you type one line</p>
        <svg class="impact" viewBox="0 0 1200 240" preserveAspectRatio="none" aria-hidden="true">
          <g stroke="currentColor" stroke-width="2" opacity=".45">
            <path d="M600 120 L0 -60" /><path d="M600 120 L120 -70" /><path d="M600 120 L260 -80" />
            <path d="M600 120 L420 -90" /><path d="M600 120 L600 -100" /><path d="M600 120 L780 -90" />
            <path d="M600 120 L940 -80" /><path d="M600 120 L1080 -70" /><path d="M600 120 L1200 -60" />
            <path d="M600 120 L0 300" /><path d="M600 120 L120 320" /><path d="M600 120 L260 330" />
            <path d="M600 120 L420 340" /><path d="M600 120 L600 350" /><path d="M600 120 L780 340" />
            <path d="M600 120 L940 330" /><path d="M600 120 L1080 320" /><path d="M600 120 L1200 300" />
          </g>
        </svg>
        <div class="body impact-body">
          <p class="sfx">SPAWN</p>
          <pre class="term inverted"><span class="w">$</span> hive ctl spawn <span class="g">--agent</span> claude <span class="g">--frame</span> api <span class="g">--prompt</span> <span class="g">"add the rate-limit test"</span></pre>
        </div>
      </section>
    </div>

    <!-- ══════════ PAGE 2 ══════════ -->
    <div class="grid r-three" id="how">
      <section class="panel">
        <div class="tone t1" aria-hidden="true"></div>
        <p class="cap">3 · the swarm lands</p>
        <div class="stack inset" aria-hidden="true">
          <div class="tile" style="left:5%;top:5%;width:58%;height:33%"><div class="bar">SCOUT</div><div class="rows"><i style="width:78%"></i><i class="f" style="width:50%"></i></div></div>
          <div class="tile" style="left:39%;top:31%;width:58%;height:33%"><div class="bar">BUILDER</div><div class="rows"><i style="width:66%"></i><i class="f" style="width:72%"></i></div></div>
          <div class="tile" style="left:15%;top:60%;width:58%;height:33%"><div class="bar">GUARD</div><div class="rows"><i style="width:58%"></i><i class="f" style="width:40%"></i></div></div>
        </div>
        <div class="foot">
          <h2>One tile, one job</h2>
          <p>A repo, a git worktree or an SSH host. Each agent gets its own cell and cannot wander into a sibling's.</p>
        </div>
      </section>

      <section class="panel">
        
        <p class="cap">4 · they hand work over</p>
        <div class="body pc talk">
          <p class="balloon">limits.ts:14 — the window is pruned <em>after</em> the push, so the Nth call always passes.</p>
          <pre class="term"><span class="c"># hand the find over</span>
<span class="w">$</span> hive ctl send tile-builder</pre>
        </div>
        <div class="foot">
          <h2>Agents drive agents</h2>
          <p>Fan out, pipeline, map-reduce, supervise. One CLI, no MCP server to babysit.</p>
        </div>
      </section>

      <section class="panel">
        <div class="tone t3" aria-hidden="true"></div>
        <p class="cap">5 · nothing ships unread</p>
        <div class="body pc denied"><p class="sfx small">DENIED</p></div>
        <div class="foot">
          <h2>A gate you control</h2>
          <p>Approve or refuse a plan and read the whole transcript. Nothing merges because a model felt sure.</p>
        </div>
      </section>
    </div>

    <!-- ══════════ PAGE 3 · THE VIEWS ══════════ -->
    <div class="grid one">
      <section class="panel">
        <p class="cap">6 · one hive, three ways to look at it</p>
        <div class="body pc">
          <h2 class="big">The workspace is a plugin.</h2>
          <p class="say">Your terminals, editor buffers and browser tabs survive the switch — tile bodies
            are mounted once and lent to whichever view is on screen.</p>

          <div class="views">
            <figure class="view">
              <svg viewBox="0 0 320 210" role="img" aria-label="Canvas view: two frames as zones on an infinite board, each holding tiles">
                <rect x="2" y="2" width="316" height="206" fill="none" stroke="currentColor" stroke-width="3"/>
                <g stroke="currentColor" stroke-width="2.5" stroke-dasharray="7 6" fill="none" opacity=".6">
                  <rect x="16" y="30" width="136" height="164"/><rect x="168" y="30" width="136" height="164"/>
                </g>
                <g class="lab on"><rect x="16" y="16" width="48" height="17" fill="currentColor"/><text x="22" y="29">API</text></g>
                <g class="lab on"><rect x="168" y="16" width="52" height="17" fill="currentColor"/><text x="174" y="29">WEB</text></g>
                <g class="win">
                  <rect x="28" y="46" width="112" height="62"/><rect x="28" y="46" width="112" height="13" class="fill"/>
                  <rect x="34" y="66" width="84" height="4" class="fill o6"/><rect x="34" y="76" width="62" height="4" class="fill o3"/>
                  <rect x="34" y="86" width="72" height="4" class="fill o6"/>
                  <rect x="28" y="120" width="112" height="60"/><rect x="28" y="120" width="112" height="13" class="fill"/>
                  <rect x="34" y="140" width="70" height="4" class="fill o6"/><rect x="34" y="150" width="88" height="4" class="fill o3"/>
                  <rect x="180" y="46" width="112" height="76"/><rect x="180" y="46" width="112" height="13" class="fill"/>
                  <rect x="186" y="66" width="90" height="4" class="fill o6"/><rect x="186" y="76" width="58" height="4" class="fill o3"/>
                  <rect x="186" y="86" width="78" height="4" class="fill o6"/><rect x="186" y="96" width="46" height="4" class="fill o3"/>
                  <rect x="180" y="134" width="112" height="46"/><rect x="180" y="134" width="112" height="13" class="fill"/>
                  <rect x="186" y="154" width="66" height="4" class="fill o6"/>
                </g>
              </svg>
              <figcaption><b>Canvas</b> — an infinite board. Frames are zones; drag, zoom, arrange.</figcaption>
            </figure>

            <figure class="view">
              <svg viewBox="0 0 320 210" role="img" aria-label="Windows view: a tab strip with one active tile filling the pane">
                <rect x="2" y="2" width="316" height="206" fill="none" stroke="currentColor" stroke-width="3"/>
                <g class="win">
                  <rect x="14" y="14" width="78" height="25" class="fill"/>
                  <rect x="96" y="14" width="72" height="25"/><rect x="172" y="14" width="66" height="25"/>
                  <rect x="242" y="14" width="64" height="25"/>
                </g>
                <g class="lab on"><text x="24" y="31">CLAUDE</text></g>
                <g class="lab"><text x="106" y="31">DIFF</text><text x="182" y="31">TREE</text><text x="252" y="31">SHELL</text></g>
                <g class="win"><rect x="14" y="49" width="292" height="147"/><rect x="14" y="49" width="292" height="15" class="fill"/></g>
                <g class="fill">
                  <rect x="26" y="78" width="180" height="5" class="o6"/><rect x="26" y="92" width="130" height="5" class="o3"/>
                  <rect x="26" y="106" width="216" height="5" class="o6"/><rect x="26" y="120" width="96" height="5" class="o3"/>
                  <rect x="26" y="134" width="164" height="5" class="o6"/><rect x="26" y="148" width="120" height="5" class="o3"/>
                  <rect x="26" y="162" width="188" height="5" class="o6"/>
                </g>
              </svg>
              <figcaption><b>Windows</b> — one tab per tile, for when you want the whole screen.</figcaption>
            </figure>

            <figure class="view">
              <svg viewBox="0 0 320 210" role="img" aria-label="World view: isometric islands, one per frame, with blocks for tiles and a docked terminal">
                <rect x="2" y="2" width="316" height="206" fill="none" stroke="currentColor" stroke-width="3"/>
                <g class="iso">
                  <path d="M96 118 L166 154 L96 190 L26 154 Z"/>
                  <path d="M206 84 L266 116 L206 148 L146 116 Z"/>
                  <path d="M72 128 L96 140 L96 116 L72 104 Z" class="fill o3"/>
                  <path d="M96 140 L120 128 L120 104 L96 116 Z" class="fill o6"/>
                  <path d="M72 104 L96 92 L120 104 L96 116 Z" class="fill"/>
                  <path d="M112 152 L130 161 L130 145 L112 136 Z" class="fill o3"/>
                  <path d="M130 161 L148 152 L148 136 L130 145 Z" class="fill o6"/>
                  <path d="M112 136 L130 127 L148 136 L130 145 Z" class="fill"/>
                  <path d="M192 104 L210 113 L210 95 L192 86 Z" class="fill o3"/>
                  <path d="M210 113 L228 104 L228 86 L210 95 Z" class="fill o6"/>
                  <path d="M192 86 L210 77 L228 86 L210 95 Z" class="fill"/>
                </g>
                <g class="win"><rect x="222" y="128" width="82" height="62"/><rect x="222" y="128" width="82" height="13" class="fill"/></g>
                <g class="fill"><rect x="228" y="148" width="60" height="4" class="o6"/><rect x="228" y="158" width="44" height="4" class="o3"/><rect x="228" y="168" width="52" height="4" class="o6"/></g>
                <path d="M214 120 L224 128" stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 4" fill="none"/>
              </svg>
              <figcaption><b>World</b> — a Three.js scene. Click a block, its live terminal docks beside it.</figcaption>
            </figure>
          </div>
          <p class="fine"><a href={link('guide/views/')}>Views are a sandboxed plugin API — write your own →</a></p>
        </div>
      </section>
    </div>

    <!-- ══════════ PAGE 4 ══════════ -->
    <div class="grid r-split">
      <section class="panel">
        <p class="cap">hive ctl</p>
        <div class="body pc">
          <pre class="term tall"><span class="c"># see who is working</span>
<span class="w">$</span> hive ctl list --json

<span class="c"># put a worker in a repo</span>
<span class="w">$</span> hive ctl spawn <span class="g">--agent</span> claude <span class="g">--frame</span> api

<span class="c"># and wait for the answer</span>
<span class="w">$</span> hive ctl read tile-builder --timeout 60000</pre>
          <p class="fine" style="margin-top:14px">Every verb takes <code>--json</code> and returns a real exit
            status, so anything that can spawn a process can drive your workspace.</p>
        </div>
      </section>

      <section class="panel">
        <p class="cap">Also in this issue</p>
        <div class="body pc">
          <ul class="more">
            <li><b>Worktrees as frames.</b> Every agent on its own branch, physically unable to collide with a sibling.</li>
            <li><b>Issues as Markdown</b> in your repo. No tracker, no account, greppable, reviewable in a diff.</li>
            <li><b>Remote hosts over SSH</b> in the same canvas as everything local — PTYs on the host, editor over SFTP.</li>
            <li><b>Bring any CLI.</b> claude, codex, droid, kiro, pi — the provider catalog is a directory, not a fork.</li>
          </ul>
        </div>
      </section>
    </div>

    <!-- ══════════ CLOSER ══════════ -->
    <div class="grid one">
      <section class="panel black closer">
        <div>
          <h2 class="big invert">Next chapter: your repo.</h2>
          <p class="fine invert">ONE BINARY · LINUX x86_64 · MIT</p>
        </div>
        <div class="btns nomargin">
          <a class="btn spot" href={`${repo}/releases`}>Download</a>
          <a class="btn" href={repo}>Read the source</a>
        </div>
      </section>
    </div>
  </main>

  <footer>
    <span>HIVEMIND · OPEN SOURCE, MIT</span>
    <span>
      <a href={link('guide/')}>DOCS</a> ·
      <a href={link('guide/cli/')}>CLI</a> ·
      <a href={link('llms.txt')}>FOR AGENTS</a> ·
      <a href={repo}>GITHUB</a>
    </span>
  </footer>
</div>

<style is:global>
  :root{
    --paper:#EDE8DB; --white:#F7F4EB; --ink:#17150F;
    --ink-2:#403D36; --ink-3:#726E64; --spot:#E8A33B;
    --inkpanel:#17150F; --inkpanel-fg:#F2EEE3;
    --gut:12px; --bd:3.5px;
    --f-d:"Archivo",Impact,sans-serif;
    --f-m:"JetBrains Mono",ui-monospace,Menlo,monospace;
    color-scheme:light;
  }
  /* Night edition. The single-theme rule was there to protect drawn artwork,
     and there is none left — the panels are UI, so they invert cleanly. */
  @media (prefers-color-scheme:dark){
    :root{
      --paper:#0B0A09; --white:#1C1A17; --ink:#F7F4EC;
      --ink-2:#DAD4C6; --ink-3:#A09A8E;
      --inkpanel:#000000; --inkpanel-fg:#F2EEE3;
      color-scheme:dark;
    }
    body::before{mix-blend-mode:screen;opacity:.10}
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;background:var(--paper);color:var(--ink);
    font-family:var(--f-m);font-size:15px;line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  body::before{
    content:"";position:fixed;inset:0;z-index:99;pointer-events:none;opacity:.28;mix-blend-mode:multiply;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='110' height='110'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='110' height='110' filter='url(%23n)' opacity='0.5'/></svg>");
  }
  a{color:inherit}
  .skip{position:absolute;left:14px;top:-60px;background:var(--ink);color:var(--paper);padding:10px 14px;z-index:200}
  .skip:focus{top:12px}
  :focus-visible{outline:3px solid var(--spot);outline-offset:3px}

  /* Near full-bleed: a comic page keeps a trim edge, but 380px of dead paper
     either side is not a trim. Panels also get real heights so the page fills
     the screen instead of shrinking into a column on a big monitor. */
  .page{max-width:min(1720px,100%);margin:0 auto;padding:16px 20px 0}

  /* screentone — three densities, the way a page does its shading */
  .tone{position:absolute;inset:0;pointer-events:none}
  .t1{background-image:radial-gradient(var(--ink) 1px,transparent 1.1px);background-size:6px 6px;opacity:.13}
  .t2{background-image:radial-gradient(var(--ink) 1.3px,transparent 1.4px);background-size:6px 6px;opacity:.30}
  .t3{background-image:radial-gradient(var(--ink) 1.7px,transparent 1.8px);background-size:5px 5px;opacity:.55}

  /* masthead */
  .mast{border:var(--bd) solid var(--ink);background:var(--white);display:grid;grid-template-columns:auto 1fr auto;align-items:stretch}
  .mast .l{border-right:var(--bd) solid var(--ink);padding:9px 13px;display:grid;align-content:center;gap:2px;text-align:center;font-size:9px;letter-spacing:.1em;line-height:1.5}
  .mast .l b{font-family:var(--f-d);font-weight:900;font-size:16px;letter-spacing:0}
  .mast .m{display:flex;align-items:center;gap:12px;padding:7px 16px;color:var(--ink)}
  .mast .title{font-family:var(--f-d);font-weight:900;font-size:clamp(22px,3.4vw,36px);letter-spacing:-.035em;line-height:1}
  .mast .r{border-left:var(--bd) solid var(--ink);padding:9px 15px;display:flex;flex-direction:column;justify-content:center;gap:3px;text-align:right;font-size:9.5px;letter-spacing:.1em}
  .mast .r a{text-decoration:none}
  .mast .r a:hover{color:#9A6B10}

  /* panels */
  .grid{display:grid;gap:var(--gut);margin-top:var(--gut)}
  .one{grid-template-columns:1fr}
  .r-hero{grid-template-columns:1.5fr 1fr;min-height:clamp(430px,70vh,680px)}
  .r-three{grid-template-columns:repeat(3,1fr)}
  .r-three .panel{min-height:clamp(400px,50vh,540px)}
  .r-split{grid-template-columns:1fr 1fr}
  .r-split .panel{min-height:clamp(300px,38vh,430px)}
  .panel{position:relative;border:var(--bd) solid var(--ink);background:var(--white);overflow:hidden}
  .panel.black{background:var(--inkpanel);color:var(--inkpanel-fg);border-color:var(--inkpanel)}
  .cap{
    position:absolute;top:0;left:0;z-index:6;margin:0;background:var(--white);color:var(--ink);
    border-right:var(--bd) solid var(--ink);border-bottom:var(--bd) solid var(--ink);
    padding:7px 12px;font-weight:700;font-size:10px;letter-spacing:.12em;text-transform:uppercase;max-width:80%
  }
  .body{position:relative;z-index:5;padding:22px}
  /* a taller panel must distribute its content, not stack it at the top */
  .r-hero>.panel:first-child{display:grid}
  .r-hero>.panel:first-child>.body{align-self:center;width:100%}
  .r-split>.panel{display:grid}
  .r-split>.panel>.body{align-self:center;width:100%}
  .body.pc{padding-top:50px}

  h1,h2{font-family:var(--f-d);margin:0;text-transform:uppercase;letter-spacing:-.035em;text-wrap:balance}
  h1{font-weight:900;font-size:clamp(34px,4.6vw,78px);line-height:.9}
  h1 em{font-style:normal;color:var(--spot);-webkit-text-stroke:2px var(--ink);paint-order:stroke fill}
  h2{font-weight:800;font-size:clamp(16px,1.15vw,19px);line-height:1.06}
  h2.big{font-size:clamp(20px,2vw,34px);line-height:1.04}
  h2.invert{color:var(--inkpanel-fg)}
  p{margin:0}
  .say{font-family:var(--f-d);font-weight:400;text-transform:none;letter-spacing:0;font-size:clamp(15px,1.05vw,17.5px);line-height:1.62;color:var(--ink-2);max-width:46ch;margin-top:16px}
  .fine{font-size:11.5px;line-height:1.6;color:var(--ink-3);letter-spacing:.05em;margin-top:16px}
  .fine.invert{color:#8E8A80}
  .fine a{color:var(--ink);text-decoration-color:var(--spot);text-decoration-thickness:2px;text-underline-offset:3px}
  .fine a:hover{color:var(--spot)}

  /* the app, drawn as line art and tone */
  .stack{position:absolute;inset:0;z-index:4}
  .stack.inset{top:44px;bottom:104px}
  .tile{position:absolute;background:var(--white);border:3px solid var(--ink);overflow:hidden}
  .tile .bar{height:16px;border-bottom:3px solid var(--ink);display:flex;align-items:center;padding:0 6px;font-size:7px;letter-spacing:.08em;font-weight:700}
  .tile .rows{padding:7px 8px;display:grid;gap:5px;align-content:start}
  .tile .rows i{display:block;height:4px;background:var(--ink);opacity:.6}
  .tile .rows i.f{opacity:.28}
  .tile .rows i.add{background:#3E8B4F;opacity:.9}
  .tile .rows i.del{background:#B4432F;opacity:.9}
  .tile .rows i.ok{background:#3E8B4F;opacity:.72}
  .tile .rows b{font-size:clamp(7px,.5vw,9px);font-weight:500;opacity:.92}
  .tile .rows b.p{color:#5CA96D}

  /* the caption strip pinned to the bottom of a story panel */
  .foot{position:absolute;bottom:0;left:0;right:0;z-index:6;background:var(--white);border-top:var(--bd) solid var(--ink);padding:13px 15px}
  .foot p{font-family:var(--f-d);font-weight:400;font-size:clamp(13px,.9vw,15px);line-height:1.55;color:var(--ink-2);margin-top:6px}

  /* impact frame */
  .impact-panel{min-height:clamp(240px,32vh,360px)}
  .impact{position:absolute;inset:0;z-index:3}
  .impact-body{position:relative;z-index:6;display:grid;place-items:center;gap:18px;min-height:inherit;padding:56px 24px 26px}
  .sfx{
    font-family:var(--f-d);font-weight:900;text-transform:uppercase;line-height:.85;letter-spacing:-.05em;
    color:var(--white);-webkit-text-stroke:5px var(--ink);paint-order:stroke fill;
    font-size:clamp(44px,8.5vw,100px);transform:rotate(-3deg);margin:0
  }
  .sfx.small{font-size:clamp(34px,5.6vw,58px);transform:rotate(-6deg)}
  .impact-body .sfx{color:var(--inkpanel-fg);-webkit-text-stroke:5px var(--inkpanel)}
  .denied{display:grid;place-items:center;min-height:200px;padding-bottom:104px}

  .balloon{
    position:relative;background:var(--white);border:3.5px solid var(--ink);border-radius:22px;
    padding:12px 16px;font-size:12.5px;line-height:1.55
  }
  .balloon::after{content:"";position:absolute;left:32px;bottom:-17px;width:0;height:0;
    border-left:14px solid transparent;border-top:18px solid var(--ink)}
  .talk{display:grid;gap:18px;align-content:start;padding-bottom:108px}

  .term{font-size:clamp(11.5px,.78vw,13.5px);
    background:var(--inkpanel);color:#DDD9CF;border:var(--bd) solid var(--inkpanel);
    padding:14px 15px;margin:0;font-family:var(--f-m);line-height:1.85;
    white-space:pre;overflow-x:auto
  }
  .term.inverted{border-color:var(--inkpanel-fg)}
  .term.tall{font-size:12px}
  .term .c{color:#7E7A70}.term .g{color:#8FD98A}.term .w{color:var(--paper)}
  code{font-family:var(--f-m);font-size:.92em;border:2px solid #DDD9CE;padding:0 4px}

  .btn{
    display:inline-block;font-family:var(--f-d);font-weight:800;font-size:13px;letter-spacing:.02em;
    text-transform:uppercase;text-decoration:none;color:var(--ink);border:var(--bd) solid var(--ink);
    background:var(--white);padding:10px 15px;box-shadow:5px 5px 0 var(--ink);
    transition:transform .08s ease,box-shadow .08s ease
  }
  .btn:hover{transform:translate(2px,2px);box-shadow:3px 3px 0 var(--ink)}
  .btn.spot{background:var(--spot)}
  .btns{display:flex;gap:11px;flex-wrap:wrap;margin-top:20px}
  .btns.nomargin{margin:0}

  .views{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
  .view{margin:0;display:grid;gap:10px}
  .view svg{display:block;width:100%;height:auto;color:var(--ink);background:var(--white)}
  .view .win rect{fill:none;stroke:currentColor;stroke-width:2.5}
  .view .win rect.fill,.view .fill rect,.view rect.fill{fill:currentColor;stroke:none}
  .view .iso path{fill:none;stroke:currentColor;stroke-width:2.5;stroke-linejoin:round}
  .view .iso path.fill{fill:currentColor}
  .view .o6{opacity:.55}.view .o3{opacity:.28}
  .view .lab text{font-family:var(--f-m);font-size:9.5px;font-weight:700;letter-spacing:.09em;fill:currentColor}
  .view .lab.on text{fill:var(--white)}
  .view figcaption{font-family:var(--f-d);font-weight:400;font-size:clamp(12.5px,.78vw,14px);line-height:1.5;color:var(--ink-2)}
  .view figcaption b{color:var(--ink);font-weight:500}
  .more{margin:0;padding:0;list-style:none;display:grid;gap:14px}
  .more li{font-family:var(--f-d);font-weight:400;font-size:clamp(13.5px,.88vw,15.5px);line-height:1.58;
    color:var(--ink-2);padding-left:15px;border-left:3px solid var(--spot)}
  .more b{color:var(--ink);font-weight:500}

  .closer{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;padding:26px 24px}
  .closer .btn{box-shadow:5px 5px 0 var(--inkpanel-fg)}
  .closer .btn:hover{box-shadow:3px 3px 0 var(--inkpanel-fg)}

  footer{
    border:var(--bd) solid var(--ink);border-top:0;background:var(--white);margin-bottom:28px;
    padding:14px 17px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
    font-size:10px;letter-spacing:.08em
  }
  footer a{text-decoration:none}
  footer a:hover{color:#9A6B10}

  @media(max-width:900px){
    .r-hero,.r-three,.r-split{grid-template-columns:1fr}
    .views{grid-template-columns:1fr}
    .mast{grid-template-columns:1fr}
    .mast .l{border-right:0;border-bottom:var(--bd) solid var(--ink)}
    .mast .r{border-left:0;border-top:var(--bd) solid var(--ink);text-align:left;flex-direction:row;gap:16px}
    .panel .stack{position:relative;height:220px;inset:auto}
    .stack.inset{top:auto;bottom:auto;margin:44px 0 0}
    .foot{position:relative}
    .talk,.denied{padding-bottom:22px}
  }
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
</style>
</body>
</html>
