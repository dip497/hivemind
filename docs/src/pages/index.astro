---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path}`;
const title = 'Hivemind — a workspace for your coding agents';
const description =
  'Run coding-agent CLIs on one canvas, next to the terminals, editor and diffs they are working on. Local, open source, driven from your shell.';
const repo = 'https://github.com/dip497/hivemind';
const install = 'bash <(curl -fsSL https://raw.githubusercontent.com/dip497/hivemind/main/install.sh)';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F7F4EE" />
  <link rel="icon" href={link('favicon.svg')} />
  <link rel="alternate" type="text/markdown" href={link('llms.txt')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="nav-in">
    <a class="brand" href={link('')} aria-label="Hivemind home">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="1.4" y="1.4" width="9.2" height="9.2" fill="currentColor" />
        <rect x="13.4" y="1.4" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width="2.2" />
        <rect x="1.4" y="13.4" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width="2.2" />
        <rect x="13.4" y="13.4" width="9.2" height="9.2" fill="none" stroke="currentColor" stroke-width="2.2" />
      </svg>
      Hivemind
    </a>
    <nav class="links" aria-label="Main">
      <a href="#how">How it works</a>
      <a href="#views">Views</a>
      <a href={link('guide/')}>Docs</a>
      <a href={repo}>GitHub</a>
    </nav>
    <a class="btn small" href={`${repo}/releases`}>Download</a>
  </div>
</header>

<main id="main">

  <!-- ─────────── HERO: what it is, then how to get it ─────────── -->
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tag">Free &amp; open source</span> Linux · MIT</p>
        <h1>Run a swarm of coding agents on one canvas.</h1>
        <p class="lede">Hivemind puts agent CLIs next to the terminals, editor and diffs they are
          working on — on your own machine, driven from your shell.</p>

        <div class="cta">
          <a class="btn primary" href={`${repo}/releases`}>Download for Linux</a>
          <a class="btn ghost" href={link('guide/getting-started/')}>Read the quickstart</a>
        </div>

        <div class="install">
          <code>{install}</code>
          <button class="copy" type="button" data-copy={install} aria-label="Copy the install command">Copy</button>
        </div>

        <ul class="trust">
          <li>No account</li><li>No cloud</li><li>Your keys, your machine</li>
        </ul>
      </div>

      <figure class="shot">
        <figcaption class="shot-cap">A workspace with two agents, a diff and a shell</figcaption>
        <svg viewBox="0 0 640 420" role="img" aria-label="The Hivemind workspace: a rail of frames and tiles on the left, with an agent terminal, a diff and a shell arranged on the canvas">
          <rect x="1" y="1" width="638" height="418" rx="6" class="app"/>
          <rect x="1" y="1" width="638" height="26" rx="6" class="chrome"/>
          <rect x="1" y="20" width="638" height="8" class="chrome"/>
          <g class="dot"><circle cx="17" cy="14" r="4"/><circle cx="31" cy="14" r="4"/><circle cx="45" cy="14" r="4"/></g>
          <text x="320" y="18" class="t-chrome">hivemind — api</text>

          <rect x="1" y="27" width="132" height="392" class="rail"/>
          <text x="14" y="48" class="t-lab">LAYERS</text>
          <g class="rail-row"><rect x="10" y="56" width="114" height="20"/></g>
          <text x="20" y="70" class="t-row on">api</text>
          <text x="28" y="96" class="t-row on">claude · scout</text>
          <text x="28" y="118" class="t-row on">claude · builder</text>
          <text x="28" y="140" class="t-row">diff</text>
          <text x="28" y="162" class="t-row">shell</text>
          <g class="rail-row"><rect x="10" y="178" width="114" height="20"/></g>
          <text x="20" y="192" class="t-row on">web</text>
          <text x="28" y="218" class="t-row">codex · nurse</text>

          <g class="tile">
            <rect x="150" y="44" width="292" height="168" rx="4"/>
            <rect x="150" y="44" width="292" height="20" rx="4" class="bar"/><rect x="150" y="58" width="292" height="6" class="bar"/>
            <text x="160" y="58" class="t-bar">claude · scout</text><circle cx="430" cy="54" r="4" class="ok"/>
          </g>
          <g class="code">
            <text x="160" y="84">$ hive ctl read tile-scout</text>
            <text x="160" y="102" class="d">limits.ts:14 — the window is pruned</text>
            <text x="160" y="118" class="d">after the push, so the Nth call passes</text>
            <text x="160" y="140">$ pytest -q tests/test_limits.py</text>
            <text x="160" y="158" class="g">1 failed, 23 passed in 0.44s</text>
            <text x="160" y="182">$ <tspan class="cur">▊</tspan></text>
          </g>

          <g class="tile">
            <rect x="330" y="176" width="298" height="150" rx="4"/>
            <rect x="330" y="176" width="298" height="20" rx="4" class="bar"/><rect x="330" y="190" width="298" height="6" class="bar"/>
            <text x="340" y="190" class="t-bar">diff · src/limits.ts</text>
          </g>
          <g class="code sm">
            <text x="340" y="214"><tspan class="g">+</tspan> if (hits.length &gt;= perMinute) return false;</text>
            <text x="340" y="230"><tspan class="g">+</tspan> hits.push(now);</text>
            <text x="340" y="246"><tspan class="r">-</tspan> buckets.set(key, hits);</text>
            <text x="340" y="262" class="d">  return true;</text>
            <text x="340" y="280"><tspan class="g">+</tspan> export function reset(key) {'{'}</text>
            <text x="340" y="296" class="d">  buckets.delete(key);</text>
          </g>

          <g class="tile">
            <rect x="150" y="238" width="168" height="118" rx="4"/>
            <rect x="150" y="238" width="168" height="20" rx="4" class="bar"/><rect x="150" y="252" width="168" height="6" class="bar"/>
            <text x="160" y="252" class="t-bar">shell</text>
          </g>
          <g class="code sm">
            <text x="160" y="278">$ git status -sb</text>
            <text x="160" y="294" class="d">## feat/limits</text>
            <text x="160" y="310" class="d"> M src/limits.ts</text>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- ─────────── TRUST STRIP ─────────── -->
  <section class="strip">
    <div class="wrap strip-in">
      <p class="strip-lab">Brings your own agents</p>
      <ul class="agents">
        <li>claude</li><li>codex</li><li>droid</li><li>kiro</li><li>pi</li>
        <li class="more">…the catalog is a directory, not a fork</li>
      </ul>
    </div>
  </section>

  <!-- ─────────── HOW IT WORKS ─────────── -->
  <section class="band" id="how">
    <div class="wrap">
      <header class="head">
        <h2>How it works</h2>
        <p class="sub">Three commands, and the agents do the rest of the talking.</p>
      </header>

      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <h3>Put an agent in a repo</h3>
          <p>Each one gets its own tile inside a frame — a repository, a git worktree, or an SSH host.
            It cannot wander into a sibling's.</p>
          <pre class="cmd"><span class="w">$</span> hive ctl spawn <span class="g">--agent</span> claude <span class="g">--frame</span> api</pre>
        </li>
        <li>
          <span class="step-n">2</span>
          <h3>Let them hand work over</h3>
          <p>One agent finds the bug and tells another where it is. Fan out, pipeline, map-reduce or
            supervise — through the same CLI, with no MCP server to babysit.</p>
          <pre class="cmd"><span class="w">$</span> hive ctl send tile-builder <span class="s">"limits.ts:14"</span></pre>
        </li>
        <li>
          <span class="step-n">3</span>
          <h3>Approve before anything lands</h3>
          <p>Read the whole transcript, then approve or refuse the plan. Nothing merges because a
            model sounded confident.</p>
          <pre class="cmd"><span class="w">$</span> hive ctl read tile-builder --timeout 60000</pre>
        </li>
      </ol>
    </div>
  </section>

  <!-- ─────────── VIEWS ─────────── -->
  <section class="band alt" id="views">
    <div class="wrap">
      <header class="head">
        <h2>Look at the same workspace three ways</h2>
        <p class="sub">Your terminals, editor buffers and browser tabs survive the switch — tile bodies
          are mounted once and lent to whichever view is on screen.</p>
      </header>

      <div class="views">
        <figure class="view">
          <svg viewBox="0 0 320 200" role="img" aria-label="Canvas view: two frames as zones on an infinite board, each holding tiles">
            <g class="vw-zone"><rect x="16" y="28" width="136" height="156"/><rect x="168" y="28" width="136" height="156"/></g>
            <g class="vw-tab"><rect x="16" y="14" width="44" height="16"/><rect x="168" y="14" width="48" height="16"/></g>
            <text x="22" y="26" class="vw-tab-t on">api</text><text x="174" y="26" class="vw-tab-t on">web</text>
            <g class="vw-win">
              <rect x="28" y="44" width="112" height="58"/><rect x="28" y="44" width="112" height="12" class="f"/>
              <rect x="28" y="114" width="112" height="56"/><rect x="28" y="114" width="112" height="12" class="f"/>
              <rect x="180" y="44" width="112" height="72"/><rect x="180" y="44" width="112" height="12" class="f"/>
              <rect x="180" y="128" width="112" height="42"/><rect x="180" y="128" width="112" height="12" class="f"/>
            </g>
            <g class="vw-line">
              <rect x="34" y="64" width="84" height="4"/><rect x="34" y="74" width="60" height="4" class="o"/><rect x="34" y="84" width="72" height="4"/>
              <rect x="34" y="134" width="70" height="4"/><rect x="34" y="144" width="86" height="4" class="o"/>
              <rect x="186" y="64" width="90" height="4"/><rect x="186" y="74" width="56" height="4" class="o"/><rect x="186" y="84" width="78" height="4"/>
              <rect x="186" y="148" width="64" height="4"/>
            </g>
          </svg>
          <figcaption><b>Canvas</b> — an infinite board. Frames are zones you drag, zoom and arrange.</figcaption>
        </figure>

        <figure class="view">
          <svg viewBox="0 0 320 200" role="img" aria-label="Windows view: a tab strip with one active tile filling the pane">
            <g class="vw-win">
              <rect x="14" y="14" width="76" height="24" class="f"/><rect x="94" y="14" width="70" height="24"/>
              <rect x="168" y="14" width="64" height="24"/><rect x="236" y="14" width="70" height="24"/>
            </g>
            <text x="24" y="30" class="vw-tab-t on">claude</text>
            <text x="104" y="30" class="vw-tab-t">diff</text><text x="178" y="30" class="vw-tab-t">tree</text><text x="246" y="30" class="vw-tab-t">shell</text>
            <g class="vw-win"><rect x="14" y="48" width="292" height="138"/><rect x="14" y="48" width="292" height="14" class="f"/></g>
            <g class="vw-line">
              <rect x="26" y="78" width="180" height="5"/><rect x="26" y="92" width="128" height="5" class="o"/>
              <rect x="26" y="106" width="216" height="5"/><rect x="26" y="120" width="96" height="5" class="o"/>
              <rect x="26" y="134" width="164" height="5"/><rect x="26" y="148" width="118" height="5" class="o"/>
            </g>
          </svg>
          <figcaption><b>Windows</b> — one tab per tile, for when you want the whole screen.</figcaption>
        </figure>

        <figure class="view">
          <svg viewBox="0 0 320 200" role="img" aria-label="World view: isometric islands, one per frame, with blocks for tiles and a terminal docked beside them">
            <g class="vw-iso">
              <path d="M92 114 L160 148 L92 182 L24 148 Z"/>
              <path d="M204 82 L262 112 L204 142 L146 112 Z"/>
              <path d="M70 124 L92 135 L92 113 L70 102 Z" class="s"/><path d="M92 135 L114 124 L114 102 L92 113 Z" class="m"/><path d="M70 102 L92 91 L114 102 L92 113 Z" class="f"/>
              <path d="M110 148 L128 157 L128 142 L110 133 Z" class="s"/><path d="M128 157 L146 148 L146 133 L128 142 Z" class="m"/><path d="M110 133 L128 124 L146 133 L128 142 Z" class="f"/>
              <path d="M190 100 L208 109 L208 92 L190 83 Z" class="s"/><path d="M208 109 L226 100 L226 83 L208 92 Z" class="m"/><path d="M190 83 L208 74 L226 83 L208 92 Z" class="f"/>
            </g>
            <g class="vw-win"><rect x="218" y="122" width="86" height="60"/><rect x="218" y="122" width="86" height="13" class="f"/></g>
            <g class="vw-line"><rect x="226" y="144" width="62" height="4"/><rect x="226" y="154" width="44" height="4" class="o"/><rect x="226" y="164" width="52" height="4"/></g>
          </svg>
          <figcaption><b>World</b> — a Three.js scene. Click a block and its live terminal docks beside it.</figcaption>
        </figure>
      </div>
      <p class="after"><a href={link('guide/views/')}>Views are a sandboxed plugin API — write your own →</a></p>
    </div>
  </section>

  <!-- ─────────── FEATURES ─────────── -->
  <section class="band">
    <div class="wrap">
      <header class="head"><h2>What else is in the box</h2></header>
      <div class="cards">
        <article><h3>Worktrees as frames</h3><p>Every agent on its own branch, physically unable to collide with a sibling's work.</p></article>
        <article><h3>Issues as Markdown</h3><p>They live in your repository. No tracker, no account — greppable, and reviewable in a diff.</p></article>
        <article><h3>Remote hosts over SSH</h3><p>PTYs on the host, editor over SFTP, in the same canvas as everything local.</p></article>
        <article><h3>Driven from the shell</h3><p>Every verb takes <code>--json</code> and returns a real exit status, so any script can drive it.</p></article>
      </div>
    </div>
  </section>

  <!-- ─────────── FAQ ─────────── -->
  <section class="band alt">
    <div class="wrap narrow">
      <header class="head"><h2>Questions people actually ask</h2></header>
      <dl class="faq">
        <dt>Does my code go anywhere?</dt>
        <dd>No. Hivemind runs on your machine and shells out to agent CLIs you installed yourself, with
          your own keys. There is no Hivemind account and no server of ours in the path.</dd>
        <dt>Which agents work with it?</dt>
        <dd>claude, codex, droid, kiro and pi today. Adding another is a directory in the provider
          catalog, not a fork.</dd>
        <dt>Do I have to learn a new tool?</dt>
        <dd>The CLIs are the ones you already use. Hivemind arranges them, keeps their sessions alive,
          and gives them one command to talk to each other.</dd>
        <dt>How finished is it?</dt>
        <dd>The canvas is released behaviour. Views-as-plugins, the World view and the new settings
          commands are development previews — the docs mark which is which.</dd>
      </dl>
    </div>
  </section>

  <!-- ─────────── CLOSE ─────────── -->
  <section class="close">
    <div class="wrap close-in">
      <div>
        <h2>Start with one repo.</h2>
        <p class="sub">One binary, Linux x86_64, MIT licensed.</p>
      </div>
      <div class="cta">
        <a class="btn primary" href={`${repo}/releases`}>Download for Linux</a>
        <a class="btn ghost" href={repo}>Read the source</a>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-in">
    <span>Hivemind — open source, MIT licensed.</span>
    <nav aria-label="Footer">
      <a href={link('guide/')}>Docs</a>
      <a href={link('guide/cli/')}>CLI reference</a>
      <a href={link('llms.txt')}>For agents</a>
      <a href={repo}>GitHub</a>
    </nav>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll('.copy').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy);
        const was = b.textContent;
        b.textContent = 'Copied'; b.classList.add('done');
        setTimeout(() => { b.textContent = was; b.classList.remove('done'); }, 1600);
      } catch { /* clipboard blocked — the command is still selectable */ }
    });
  });
</script>

<style is:global>
  /* ───────────────────────────────────────────────────────────────────────
     Readability first. The rules this follows, and why:
       · sentence case — all-caps forces letter-by-letter reading and slows
         dyslexic readers 13–18%, so nothing you have to *read* is uppercase
       · 60–70 characters per line of prose (66 optimal, WCAG caps at 80)
       · line-height ≥ 1.5 on body text (WCAG 1.4.12)
       · body text ≥ 4.5:1 against its own background, large text ≥ 3:1
       · mono is for code and short labels only, never running prose
     The comic voice survives in the details — the offset shadows, the hard
     borders, the amber — not in the structure. A visitor should be able to
     answer "what is this, do I need it, how do I get it" without decoding
     a page.
     ─────────────────────────────────────────────────────────────────────── */
  :root{
    --paper:#F7F4EE; --surface:#FFFFFF; --sunk:#F1EDE3;
    --ink:#15130F; --body:#3A362E; --muted:#5E594F;
    --line:#E1DBCC;
    --accent:#8A5205; --accent-bg:#E8A33B; --accent-soft:#FBEBCD;
    --code-bg:#15130F; --code-fg:#E9E5DA; --ok:#2E7D4F;
    --f:"Archivo",ui-sans-serif,system-ui,-apple-system,sans-serif;
    --f-m:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --w:1180px;
    color-scheme:light;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;background:var(--paper);color:var(--body);
    font-family:var(--f);font-size:17px;line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit}
  :focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:2px}
  .skip{position:absolute;left:16px;top:-60px;background:var(--ink);color:var(--paper);padding:10px 14px;z-index:200;border-radius:4px}
  .skip:focus{top:12px}
  .wrap{max-width:var(--w);margin:0 auto;padding:0 24px}
  .wrap.narrow{max-width:820px}

  h1,h2,h3{color:var(--ink);margin:0;text-wrap:balance;letter-spacing:-.02em}
  h1{font-size:clamp(34px,4.4vw,54px);line-height:1.08;font-weight:800}
  h2{font-size:clamp(26px,2.8vw,36px);line-height:1.16;font-weight:700}
  h3{font-size:19px;line-height:1.3;font-weight:700}
  p{margin:0}
  .lede{font-size:clamp(17px,1.25vw,20px);line-height:1.6;color:var(--body);max-width:56ch;margin-top:18px}
  .sub{font-size:17px;line-height:1.6;color:var(--muted);max-width:64ch;margin-top:12px}

  .nav{position:sticky;top:0;z-index:50;background:rgba(247,244,238,.93);
    backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav-in{max-width:var(--w);margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;gap:26px}
  .brand{display:flex;align-items:center;gap:9px;font-weight:700;font-size:18px;color:var(--ink);text-decoration:none;letter-spacing:-.02em}
  .links{display:flex;gap:22px;margin-left:auto;font-size:15px}
  .links a{color:var(--body);text-decoration:none}
  .links a:hover{color:var(--ink)}

  .btn{display:inline-flex;align-items:center;justify-content:center;font-weight:600;font-size:16px;
    text-decoration:none;padding:12px 20px;border-radius:6px;border:2px solid var(--ink);
    background:var(--surface);color:var(--ink);transition:transform .08s ease,box-shadow .08s ease}
  .btn.primary{background:var(--accent-bg);box-shadow:4px 4px 0 var(--ink)}
  .btn.primary:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)}
  .btn.ghost{background:transparent}
  .btn.ghost:hover{background:var(--sunk)}
  .btn.small{padding:8px 15px;font-size:15px;margin-left:4px}
  .cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}

  .hero{padding:clamp(40px,6vw,76px) 0 clamp(36px,5vw,60px)}
  .hero-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(28px,4vw,56px);align-items:center}
  .eyebrow{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--muted);margin-bottom:18px}
  .tag{background:var(--accent-soft);color:var(--accent);border:1px solid #E7CFA0;
    padding:3px 9px;border-radius:999px;font-size:13px;font-weight:600}
  .install{display:flex;align-items:stretch;margin-top:22px;border:2px solid var(--ink);border-radius:6px;overflow:hidden}
  .install code{flex:1;min-width:0;overflow-x:auto;white-space:nowrap;background:var(--code-bg);color:var(--code-fg);
    font-family:var(--f-m);font-size:13px;padding:12px 14px;border:0;border-radius:0}
  .copy{border:0;border-left:2px solid var(--ink);background:var(--surface);color:var(--ink);
    font-family:var(--f);font-weight:600;font-size:14px;padding:0 16px;cursor:pointer}
  .copy:hover{background:var(--sunk)}
  .copy.done{background:var(--ok);color:#fff}
  .trust{list-style:none;display:flex;flex-wrap:wrap;gap:8px 20px;margin:20px 0 0;padding:0;font-size:14.5px;color:var(--muted)}
  .trust li{position:relative;padding-left:17px}
  .trust li::before{content:"";position:absolute;left:0;top:.55em;width:8px;height:8px;background:var(--accent-bg);border:1.5px solid var(--ink)}

  .shot{margin:0}
  .shot svg{display:block;width:100%;height:auto;border:2px solid var(--ink);border-radius:8px;box-shadow:8px 8px 0 var(--line)}
  .shot-cap{font-size:13px;color:var(--muted);margin-bottom:9px}
  .app{fill:#1A1814}
  .chrome{fill:#25221C}
  .dot circle{fill:#5E594E}
  .rail{fill:#201E19}
  .tile rect{fill:#141210;stroke:#37332A;stroke-width:1.5}
  .tile rect.bar{fill:#26231C;stroke:none}
  .rail-row rect{fill:#2E2A22;stroke:none}
  .ok{fill:#57C07E}
  .shot text{font-family:var(--f-m)}
  .t-chrome{fill:#7C7669;font-size:9px;text-anchor:middle}
  .t-lab{fill:#6E6858;font-size:8px;letter-spacing:.12em}
  .t-row{fill:#9E988A;font-size:9px}
  .t-row.on{fill:#DCD6C8}
  .t-bar{fill:#ADA799;font-size:9px}
  .code text{fill:#D3CDBF;font-size:10px}
  .code.sm text{font-size:9px}
  .code .d{fill:#948D7F}
  .code .g,.code tspan.g{fill:#7ACB96}
  .code .r,.code tspan.r{fill:#E08A72}
  .cur{fill:#E8A33B}

  .strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--sunk)}
  .strip-in{display:flex;align-items:center;gap:24px;flex-wrap:wrap;padding-top:18px;padding-bottom:18px}
  .strip-lab{font-size:14px;color:var(--muted)}
  .agents{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:0;padding:0}
  .agents li{font-family:var(--f-m);font-size:13.5px;color:var(--ink);background:var(--surface);
    border:1px solid var(--line);border-radius:4px;padding:5px 11px}
  .agents li.more{font-family:var(--f);border:0;background:none;color:var(--muted);padding-left:2px}

  .band{padding:clamp(44px,5.5vw,80px) 0}
  .band.alt{background:var(--sunk);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .head{margin-bottom:clamp(26px,3vw,40px)}

  .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .steps li{background:var(--surface);border:2px solid var(--ink);border-radius:8px;padding:24px;
    box-shadow:5px 5px 0 var(--line);display:grid;gap:12px;align-content:start}
  .step-n{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:999px;
    background:var(--accent-bg);border:2px solid var(--ink);font-weight:700;font-size:15px;color:var(--ink)}
  .steps p{font-size:15.5px;line-height:1.6;color:var(--body)}
  .cmd{margin:4px 0 0;background:var(--code-bg);color:var(--code-fg);border-radius:5px;
    font-family:var(--f-m);font-size:12.5px;line-height:1.75;padding:11px 12px;white-space:pre-wrap;overflow-wrap:anywhere}
  .cmd .w{color:#fff}.cmd .g{color:#8FD98A}.cmd .s{color:#E8C77B}

  .views{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .view{margin:0;display:grid;gap:12px}
  .view svg{display:block;width:100%;height:auto;background:var(--surface);
    border:2px solid var(--ink);border-radius:6px;color:var(--ink)}
  .vw-zone rect{fill:none;stroke:currentColor;stroke-width:2;stroke-dasharray:6 5;opacity:.5}
  .vw-tab rect{fill:currentColor}
  .vw-tab-t{font-family:var(--f-m);font-size:9px;font-weight:700;fill:currentColor}
  .vw-tab-t.on{fill:var(--surface)}
  .vw-win rect{fill:none;stroke:currentColor;stroke-width:2}
  .vw-win rect.f{fill:currentColor;stroke:none}
  .vw-line rect{fill:currentColor;opacity:.62}
  .vw-line rect.o{opacity:.3}
  .vw-iso path{fill:none;stroke:currentColor;stroke-width:2;stroke-linejoin:round}
  .vw-iso path.f{fill:currentColor}
  .vw-iso path.m{fill:currentColor;opacity:.55}
  .vw-iso path.s{fill:currentColor;opacity:.28}
  .view figcaption{font-size:15px;line-height:1.55;color:var(--muted)}
  .view figcaption b{color:var(--ink);font-weight:700}
  .after{margin-top:26px;font-size:16px}
  .after a{color:var(--ink);font-weight:600;text-decoration-color:var(--accent-bg);text-decoration-thickness:2px;text-underline-offset:4px}

  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .cards article{display:grid;gap:9px;align-content:start;padding-top:16px;border-top:3px solid var(--ink)}
  .cards p{font-size:15.5px;line-height:1.6;color:var(--body)}
  code{font-family:var(--f-m);font-size:.88em;background:var(--sunk);border:1px solid var(--line);
    border-radius:3px;padding:1px 5px}

  .faq{margin:0}
  .faq dt{font-weight:700;color:var(--ink);font-size:18px;margin-top:26px}
  .faq dt:first-of-type{margin-top:0}
  .faq dd{margin:8px 0 0;font-size:16.5px;line-height:1.65;color:var(--body);max-width:68ch}

  .close{background:var(--ink);color:var(--paper);padding:clamp(36px,4.5vw,60px) 0}
  .close h2{color:var(--paper)}
  .close .sub{color:#A9A395;margin-top:8px}
  .close-in{display:flex;align-items:center;justify-content:space-between;gap:26px;flex-wrap:wrap}
  .close .btn.ghost{border-color:var(--paper);color:var(--paper)}
  .close .btn.ghost:hover{background:#2A2721}
  .close .btn.primary{box-shadow:4px 4px 0 var(--paper)}
  .close .btn.primary:hover{box-shadow:2px 2px 0 var(--paper)}

  .foot{border-top:1px solid var(--line);padding:26px 0 40px;font-size:14.5px;color:var(--muted)}
  .foot-in{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}
  .foot nav{display:flex;gap:20px}
  .foot a{text-decoration:none}
  .foot a:hover{color:var(--ink)}

  @media(max-width:960px){
    .hero-in{grid-template-columns:1fr}
    .steps,.cards{grid-template-columns:1fr 1fr}
    .views{grid-template-columns:1fr}
  }
  @media(max-width:640px){
    body{font-size:16px}
    .links{display:none}
    .steps,.cards{grid-template-columns:1fr}
    .close-in{flex-direction:column;align-items:flex-start}
  }
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
</style>
</body>
</html>
