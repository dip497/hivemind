---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path}`;
const title = 'Hivemind — A workspace for your coding agents';
const description = 'A Linux workspace for coding agents, terminals, editors, and diffs. Control it from the desktop or the hive CLI.';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#101112" /><title>{title}</title><link rel="icon" href={link('icon.png')} /><link rel="alternate" type="text/markdown" href={link('llms.txt')} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="page">
<header><a class="brand" href={link('')} aria-label="Hivemind home"><img src={link('icon.png')} width="33" height="33" alt="" />hivemind</a><nav aria-label="Main navigation"><a href={link('guide/')}>Documentation</a><a href="https://github.com/dip497/hivemind">GitHub</a></nav></header>
<main id="main">
<section class="hero">
<div class="eyebrow"><span></span> OPEN SOURCE · LOCAL FIRST · LINUX</div>
<h1>A workspace for<br /><span>coding agents.</span></h1>
<p class="lede">Run agents alongside your terminals, editor, and diffs.</p>
<div class="actions"><a class="button primary" href="https://github.com/dip497/hivemind/releases">Download for Linux</a><a class="button" href={link('guide/getting-started/')}>Read the quickstart</a></div>

<div class="product"><div class="product-bar"><div><i></i><i></i><i></i></div><span>hivemind / workspace</span><span>LOCAL</span></div><img src={link('workspace.webp')} alt="Hivemind with live terminal, file explorer, and diff tools arranged in a workspace" width="900" height="532" fetchpriority="high" /></div>
</section>
<section class="overview" aria-labelledby="overview-title"><h2 id="overview-title">Projects, tools, and agents.</h2><div class="features"><article><span class="number">01 / CONTEXT</span><h3>Project workspaces</h3><p>Group tools by repository, git worktree, or SSH host.</p></article><article><span class="number">02 / VISIBILITY</span><h3>Terminals and code</h3><p>Read agent output, edit files, and review diffs side by side.</p></article><article><span class="number">03 / CONTROL</span><h3>CLI control</h3><p>Use <code>hive</code> to start agents, send tasks, and read replies.</p></article></div></section>
<section class="cli" aria-labelledby="cli-title"><div><h2 id="cli-title">Control it from the shell.</h2><p>Agents can use the same CLI to delegate tasks and read results.</p><a class="text-link" href={link('guide/agent-workflows/')}>Agent workflow guide</a></div><div class="terminal"><div class="terminal-label">hive ctl</div><pre><code><span class="comment"># Find your workspaces</span>
<span class="prompt">$</span> hive ctl frames

<span class="comment"># See who is working</span>
<span class="prompt">$</span> hive ctl list

<span class="comment"># Start a focused task</span>
<span class="prompt">$</span> hive ctl spawn --agent claude \
    --prompt "Review the current diff"</code></pre></div></section>
<section class="extensions"><div class="eyebrow">IN DEVELOPMENT</div><h2>Switch workspace views.</h2><p>Switch between a canvas, tabs, and community views while keeping your tools open.</p><a class="text-link" href={link('guide/views/')}>Workspace views</a></section>

</main>
<footer><a class="brand" href={link('')}><img src={link('icon.png')} width="24" height="24" alt="" />hivemind</a><span>Open source. MIT licensed.</span><nav aria-label="Footer"><a href={link('guide/')}>Docs</a><a href={link('llms.txt')}>For agents</a><a href="https://github.com/dip497/hivemind">Source</a></nav></footer>
</div>
</body></html>
<style>
:global(*){box-sizing:border-box} :global(html){color-scheme:dark;scroll-behavior:smooth} :global(body){margin:0;background:#101112;color:#f3f2ee;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:2px solid #eabe62;outline-offset:6px} .page{max-width:1160px;margin:auto;padding:0 36px}header{height:96px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #292b2c}.brand{display:inline-flex;align-items:center;gap:10px;font-size:23px;font-weight:630;letter-spacing:-1px}.brand img{border-radius:9px}nav{display:flex;gap:28px;font-size:14px;color:#bfc0bc}nav a:hover,.text-link:hover{color:#eabe62}.hero{text-align:center;padding-top:86px}.eyebrow{font-size:11px;font-weight:550;letter-spacing:1.8px;color:#b5b6b1}.eyebrow>span{display:inline-block;width:6px;height:6px;border-radius:50%;background:#eabe62;margin-right:8px;vertical-align:middle}h1{font-size:clamp(48px,6.6vw,82px);line-height:1.08;letter-spacing:-4px;font-weight:530;margin:27px 0 22px}h1 span{color:#eabe62}.lede{font-size:20px;line-height:1.6;color:#b8b9b5;letter-spacing:-.3px}.actions{display:flex;justify-content:center;gap:12px;margin:29px 0 17px}.button{display:inline-flex;align-items:center;gap:24px;justify-content:space-between;padding:13px 20px;border:1px solid #363838;border-radius:7px;font-size:14px;font-weight:550;min-height:46px}.button:hover{border-color:#b5b6b1}.primary{background:#eabe62;color:#17150f;border-color:#eabe62}.primary:hover{background:#f6d288;border-color:#f6d288}.small{font-size:12px;color:#9a9c96}.product{max-width:1020px;margin:55px auto 0;border:1px solid #363838;border-radius:12px;overflow:hidden;box-shadow:0 28px 70px #0005}.product-bar{height:36px;background:#191b1c;display:flex;align-items:center;justify-content:space-between;padding:0 16px;font-family:monospace;font-size:10px;color:#959993;letter-spacing:1px}.product-bar>div{display:flex;gap:5px}.product-bar i{width:6px;height:6px;border:1px solid #727773;border-radius:50%}.product img{display:block;width:100%;height:auto}section.overview{padding:105px 0 88px}h2{font-size:clamp(30px,4vw,44px);line-height:1.15;letter-spacing:-1.7px;font-weight:500;margin:19px 0 28px}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:42px;margin-top:48px}.number{font-family:monospace;font-size:11px;color:#d3ad60;letter-spacing:.6px}h3{font-size:19px;letter-spacing:-.5px;font-weight:550;margin:17px 0 12px}.features p,.cli p,.extensions p{font-size:16px;line-height:1.8;color:#b5b6b1;margin:0}.features code{color:#e9c474}.cli{border-top:1px solid #292b2c;border-bottom:1px solid #292b2c;padding:70px 0;display:grid;grid-template-columns:1fr 1fr;gap:65px}.cli h2{margin-bottom:20px}.text-link{display:inline-flex;gap:25px;margin-top:24px;font-size:14px;color:#eabe62}.terminal{background:#17191a;border:1px solid #303233;border-radius:9px;align-self:center;overflow:hidden}.terminal-label{border-bottom:1px solid #303233;padding:13px 20px;color:#a7aaa4;font:12px monospace}.terminal pre{font-size:13px;line-height:1.8;padding:20px;margin:0;overflow-x:auto;color:#e5e5df}.comment{color:#92968e}.prompt{color:#eabe62}.extensions{padding:88px 0;max-width:640px}.extensions .eyebrow{color:#eabe62}.closing{display:flex;align-items:center;justify-content:space-between;padding:48px 0;border-top:1px solid #292b2c}.closing h2{margin:0;font-size:32px}footer{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:30px 0 40px;color:#a4a69f;font-size:12px}footer .brand{font-size:19px}footer nav{font-size:12px;gap:20px}.skip{position:absolute;left:20px;top:-80px;padding:12px;background:#eabe62;color:#101112;z-index:5}.skip:focus{top:12px}@media(max-width:700px){.page{padding:0 22px}header{height:76px}nav{gap:18px;font-size:12px}.brand{font-size:21px}.hero{padding-top:56px}h1{letter-spacing:-2px}.lede{font-size:17px}.actions{flex-direction:column;max-width:300px;margin:26px auto 18px}.product{margin-top:36px}.features,.cli{grid-template-columns:1fr;gap:32px}section.overview{padding:65px 0}.cli{padding:45px 0}.extensions{padding:60px 0}.closing{align-items:flex-start;flex-direction:column;gap:25px}footer{align-items:flex-start;flex-wrap:wrap}footer>span{display:none}.eyebrow{font-size:10px;letter-spacing:1.3px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
