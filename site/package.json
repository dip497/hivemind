{
  "name": "hivemind-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && npm run guide",
    "guide": "npm --prefix docs run build && node scripts/add-guide.mjs",
    "guide:dev": "npm --prefix docs run dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "node --test",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "prebuild": "node scripts/sync-tokens.mjs && node scripts/sync-install.mjs && node scripts/sync-agent-icons.mjs",
    "build:domain": "SITE_URL=https://hivemind.griiken.com npm run build",
    "deploy:firebase": "npm run build:domain && firebase deploy --only hosting",
    "install:sync": "node scripts/sync-install.mjs",
    "install:check": "node scripts/sync-install.mjs --check",
    "icons:sync": "node scripts/sync-agent-icons.mjs",
    "icons:check": "node scripts/sync-agent-icons.mjs --check",
    "diagrams": "node scripts/diagrams/build.mjs"
  },
  "dependencies": {
    "astro": "7.3.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "playwright": "1.63.0",
    "subset-font": "2.9.0"
  }
}
