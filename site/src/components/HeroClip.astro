---
// The hero: one take of the real app (apps/desktop/scripts/site-clip.mjs), its steps as tabs.
// What paints first is a still of the clip's first frame, made at build time; the clip itself
// is fetched only after the page has loaded, while the hero is on screen.
import clip from '../data/hero-clip.json';
import { wideStill, phoneStill, wideStep, phoneStep, WIDE_SIZES, PHONE_SIZES, PHONE_QUERY } from '../lib/hero-images';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (f: string) => `${base}/shots/hero/${f}`;
const STEPS: Record<string, { tab: string; say: string; alt: string }> = {
  view: { tab: 'A view', say: '“Show my workspace as islands.”',
    alt: 'An agent’s terminal in Hivemind, where the person asks it to show the workspace as islands.' },
  widget: { tab: 'A widget', say: '“Put a CI light where I can see it.”',
    alt: 'A CI light widget, green after the build passed, beside the agent’s terminal.' },
  tool: { tab: 'A tool', say: '“Find the flaky tests.”',
    alt: 'The Flaky tests tool open on the canvas, each test with one square per run.' },
};
const [poster, posterPhone] = await Promise.all([wideStill('poster'), phoneStill('poster')]);
const steps = await Promise.all(clip.steps.map(async (s) => {
  const [wide, phone] = await Promise.all([wideStep(`step-${s.key}`), phoneStep(`step-${s.key}`)]);
  return { ...s, ...STEPS[s.key], wide: wide.avif, phone: phone.avif };
}));
const sources = { wide: [shot('clip.webm'), shot('clip.mp4')], mid: [shot('clip-1440.webm'), shot('clip-1440.mp4')], phone: [shot('clip-phone.webm'), shot('clip-phone.mp4')] };
---

<figure class="hc" data-hc data-steps={JSON.stringify(clip.steps)} data-sources={JSON.stringify(sources)} data-wide-sizes={WIDE_SIZES} data-phone-sizes={PHONE_SIZES}
  aria-label="One take of Hivemind: an agent adds a view, a widget and a tool to the workspace it works in.">
  <div class="hc-steps" role="tablist" aria-label="What the person asks for">
    {steps.map((s, i) => (
      <button type="button" role="tab" id={`hc-tab-${s.key}`} aria-controls="hc-frame" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}
        data-wide={s.wide} data-phone={s.phone} data-alt={s.alt}>
        <b>{s.tab}</b><span>{s.say}</span><i></i>
      </button>
    ))}
    <button type="button" class="hc-pause" aria-pressed="false" aria-label="Pause the recording" data-pause>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path class="hc-i-pause" d="M5 3.5v9M11 3.5v9"/><path class="hc-i-play" d="M5 3.2v9.6L12.6 8z"/></svg>
    </button>
  </div>
  <div class="hc-frame" id="hc-frame" role="tabpanel" aria-labelledby={`hc-tab-${steps[0].key}`}>
    <picture>
      <source media={PHONE_QUERY} type="image/avif" srcset={posterPhone.avif} sizes={PHONE_SIZES} />
      <source media={PHONE_QUERY} type="image/webp" srcset={posterPhone.webp} sizes={PHONE_SIZES} />
      <source type="image/avif" srcset={poster.avif} sizes={WIDE_SIZES} />
      <img class="hc-poster" src={poster.src} srcset={poster.webp} sizes={WIDE_SIZES} width={poster.width} height={poster.height}
        alt={steps[0].alt} fetchpriority="high" loading="eager" decoding="sync" data-poster />
    </picture>
    <video class="hc-video" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video>
  </div>
</figure>

<style is:global>
  .hc{position:relative;margin:0;border-radius:14px;background:var(--bg2);border:1px solid var(--line2);overflow:hidden;
    box-shadow:0 24px 64px -32px oklch(0 0 0 / .6),inset 0 1px 0 oklch(1 0 0 / .06)}
  .hc-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;border-bottom:1px solid var(--line2)}
  .hc-steps [role="tab"]{position:relative;display:grid;gap:3px;text-align:left;font:inherit;background:transparent;border:0;
    border-right:1px solid var(--line);padding:14px 20px 15px;cursor:pointer;color:var(--fg3);transition:color .2s var(--ease),background-color .2s var(--ease);contain:paint}
  .hc-steps [role="tab"] b{font:600 13.5px/1.2 var(--f);letter-spacing:-.005em;color:inherit}
  .hc-steps [role="tab"] span{font-size:15px;line-height:1.35;color:var(--fg3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .2s var(--ease)}
  .hc-steps [role="tab"][aria-selected="true"]{color:var(--fg);background:color-mix(in oklab,var(--fg) 3%,transparent)}
  .hc-steps [role="tab"][aria-selected="true"] span{color:var(--fg)}
  .hc-steps [role="tab"] i{position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--fg);transform:scaleX(var(--p,0));transform-origin:left}
  .hc-pause{display:grid;place-items:center;width:56px;color:var(--fg3);background:transparent;border:0;cursor:pointer;transition:color .15s ease}
  .hc-pause svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .hc-pause .hc-i-play,.hc-pause[aria-pressed="true"] .hc-i-pause{display:none}
  .hc-pause[aria-pressed="true"] .hc-i-play{display:inline}
  .hc-steps [role="tab"]:focus-visible,.hc-pause:focus-visible{outline:2px solid var(--fg2);outline-offset:-2px}
  .hc-frame{position:relative;aspect-ratio:2560/1600;background:var(--bg)}
  .hc-frame picture,.hc-poster,.hc-video{position:absolute;inset:0;width:100%;height:100%;display:block}
  .hc-poster,.hc-video{object-fit:cover;object-position:50% 0}
  .hc-video{opacity:0;transition:opacity .4s var(--ease)}
  .hc[data-playing] .hc-video{opacity:1}
  @media (hover:hover) and (pointer:fine){
    .hc-steps [role="tab"]:hover,.hc-pause:hover{color:var(--fg)}
    .hc-steps [role="tab"]:hover span{color:var(--fg2)}
  }
  @media (max-width:640px){
    .hc{border-radius:12px}
    .hc-steps [role="tab"]{padding:12px 12px 13px}
    .hc-steps [role="tab"] span{display:none}
    .hc-pause{width:44px}
    .hc-frame{aspect-ratio:720/900}
  }
  @media (prefers-reduced-motion:reduce){
    .hc-steps [role="tab"] i,.hc-pause{display:none}
    .hc-steps{grid-template-columns:repeat(3,minmax(0,1fr))}
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hc]');
  if (root) {
    const steps: { key: string; at: number }[] = JSON.parse(root.dataset.steps!);
    const sources: Record<'wide' | 'mid' | 'phone', string[]> = JSON.parse(root.dataset.sources!);
    const video = root.querySelector('video')!;
    const poster = root.querySelector<HTMLImageElement>('[data-poster]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const phone = matchMedia('(max-width: 640px)');
    let current = 0, paused = false, loaded = false, inView = false, ready = false, wake = 0;

    const frameEl = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const select = (i: number) => {
      current = i;
      tabs.forEach((t, n) => { t.setAttribute('aria-selected', n === i ? 'true' : 'false'); t.tabIndex = n === i ? 0 : -1; });
      frameEl.setAttribute('aria-labelledby', tabs[i].id);
    };
    // Without the clip (less motion asked for, or not loaded yet) a tab shows that step's still.
    const showStill = (i: number) => {
      const t = tabs[i];
      const picture = poster.parentElement!;
      picture.querySelectorAll('source').forEach((s) => s.remove());
      poster.sizes = phone.matches ? root.dataset.phoneSizes! : root.dataset.wideSizes!;
      poster.srcset = phone.matches ? t.dataset.phone! : t.dataset.wide!;
      poster.alt = t.dataset.alt!;
    };
    const stepAt = (time: number) => steps.reduce((n, s, i) => (time >= s.at ? i : n), 0);
    const bars = tabs.map((t) => t.querySelector('i')!);
    let fill: Animation | null = null;
    // The step's bar fills on the compositor; the page wakes only when the next step starts.
    const sync = () => {
      clearTimeout(wake);
      fill?.cancel(); fill = null;
      if (!video.duration) return;
      const time = video.currentTime;
      const i = stepAt(time);
      const end = steps[i + 1]?.at ?? video.duration;
      if (i !== current) select(i);
      const left = Math.max(0, end - time) / (video.playbackRate || 1);
      const from = Math.min(1, (time - steps[i].at) / (end - steps[i].at));
      fill = bars[i].animate([{ transform: `scaleX(${from})` }, { transform: 'scaleX(1)' }], { duration: left * 1000, easing: 'linear', fill: 'forwards' });
      if (video.paused) fill.pause();
      else wake = window.setTimeout(sync, Math.max(30, left * 1000 + 20));
    };
    const hold = () => { clearTimeout(wake); fill?.pause(); };
    const load = () => {
      if (loaded) return;
      loaded = true;
      const width = root.getBoundingClientRect().width * devicePixelRatio;
      const pick = phone.matches ? sources.phone : width > 1600 ? sources.wide : sources.mid;
      pick.forEach((src) => {
        const s = document.createElement('source');
        s.src = src; s.type = src.endsWith('.webm') ? 'video/webm' : 'video/mp4';
        video.append(s);
      });
      video.preload = 'auto';
      video.load();
    };
    const play = () => {
      if (reduce.matches || paused || !ready || !inView) return;
      load();
      video.play().catch(() => {});
    };
    video.addEventListener('playing', () => { root.setAttribute('data-playing', ''); sync(); });
    video.addEventListener('pause', sync);
    video.addEventListener('seeking', sync);
    video.addEventListener('seeked', sync);
    video.addEventListener('ratechange', sync);
    video.addEventListener('waiting', hold);
    tabs.forEach((t, i) => t.addEventListener('click', () => {
      select(i);
      // Until the clip plays, the tab's still answers the click.
      if (reduce.matches || !root.hasAttribute('data-playing')) showStill(i);
      if (reduce.matches) return;
      load();
      video.currentTime = steps[i].at + 0.05;
      setPaused(false);
      ready = true; play();
    }));
    tabs.forEach((t, i) => t.addEventListener('keydown', (e) => {
      const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      const next = tabs[(to + tabs.length) % tabs.length];
      next.focus(); next.click();
    }));
    function setPaused(on: boolean) {
      paused = on;
      pause.setAttribute('aria-pressed', String(on));
      pause.setAttribute('aria-label', on ? 'Play the recording' : 'Pause the recording');
    }
    pause.addEventListener('click', () => {
      setPaused(!paused);
      if (paused) video.pause(); else play();
    });
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; if (inView) play(); else video.pause(); }, { rootMargin: '120px' }).observe(root);
    // The clip waits until the page has painted and gone quiet.
    const start = () => { ready = true; play(); };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
    reduce.addEventListener('change', () => { if (reduce.matches) { video.pause(); root.removeAttribute('data-playing'); } else play(); });
  }
</script>
