---
import { HIVEHUB } from "../hivehub";
import Loop from '../components/Loop.astro';
import icons from '../generated/agent-icons.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path}`;
const title = 'Hivemind: your agents build the workspace they work in';
const description =
  'Personal software for people who code with agents. Run agent CLIs side by side and have them write the widgets, tools and views you work with. MIT licensed, on your own computer, with no account.';
const repo = 'https://github.com/dip497/hivemind';
const changelog = `${repo}/blob/main/CHANGELOG.md#2026103--2026-10-18`;
const install = 'bash <(curl -fsSL https://hivemind.griiken.com/install.sh)';
const installPs = 'irm https://hivemind.griiken.com/install.ps1 | iex';
// Every file link goes through /download/<key>, which the server sends on to the current release.
const dl = (key: string) => `${base}/download/${key}`;
const agents = icons.agents;
const ogImage = new URL(link('shots/og.jpg'), Astro.site).href;
const shot = (file: string, width = 1600, height = 1120) => ({ file, width, height });
type Example = { id: string; name: string; w?: number; h?: number; alt?: string };
const examples: { kind: string; one: string; fit: string; scope: string; items: Example[] }[] = [
  { kind: 'Widgets', one: 'widget', fit: 'contain', scope: '@dip497/', items: [
    { id: 'waiting-on-you', name: 'Waiting on you', w: 592, h: 421 },
    { id: 'agent-pulse', name: 'Agent pulse', w: 592, h: 354 },
    { id: 'focus-timer', name: 'Focus timer', w: 592, h: 381 },
    { id: 'ci-light', name: 'CI light', w: 592, h: 436 },
    { id: 'test-meter', name: 'Test meter', w: 592, h: 477 },
    { id: 'spend-today', name: 'Spend today', w: 592, h: 448 },
    { id: 'issue-burndown', name: 'Issue burndown', w: 592, h: 846 },
    { id: 'launchpad', name: 'Launchpad', w: 592, h: 476 },
    { id: 'dog', name: 'Dog', w: 960, h: 600, alt: 'The Dog widget: Biscuit barks when an agent waits on you, then walks to the right edge.' },
  ] },
  { kind: 'Tools', one: 'tool', fit: 'cover', scope: 'dip497/', items: [
    { id: 'dependency-audit', name: 'Dependency audit' },
    { id: 'flaky-tests', name: 'Flaky tests' },
    { id: 'changelog-writer', name: 'Changelog writer' },
    { id: 'release-checklist', name: 'Release checklist' },
    { id: 'bundle-size', name: 'Bundle size' },
    { id: 'sqlite-browser', name: 'SQLite browser' },
    { id: 'log-tail', name: 'Log tail' },
    { id: 'api-explorer', name: 'API explorer' },
  ] },
  { kind: 'Views', one: 'view', fit: 'cover', scope: '@dip497/', items: [
    { id: 'constellation', name: 'Constellation' },
    { id: 'timeline', name: 'Timeline' },
    { id: 'agents-by-state', name: 'Agents by state' },
    { id: 'workspace-map', name: 'Workspace map' },
  ] },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#111316" />
  <link rel="icon" href={link('favicon.svg')} />
  <link rel="alternate" type="text/markdown" href={link('llms.txt')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="nav-in">
    <a class="brand" href={link('')} aria-label="Hivemind home">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M11.14 1.70 Q12 1.20 12.86 1.70 L16.51 3.80 Q17.37 4.30 17.37 5.29 L17.37 9.51 Q17.37 10.50 16.51 11 L12.86 13.10 Q12 13.60 11.14 13.10 L7.49 11 Q6.63 10.50 6.63 9.51 L6.63 5.29 Q6.63 4.30 7.49 3.80 Z" fill="currentColor" />
        <path d="M5.60 11.30 Q6.46 10.80 7.32 11.30 L10.97 13.40 Q11.83 13.90 11.83 14.89 L11.83 19.11 Q11.83 20.10 10.97 20.60 L7.32 22.70 Q6.46 23.20 5.60 22.70 L1.95 20.60 Q1.09 20.10 1.09 19.11 L1.09 14.89 Q1.09 13.90 1.95 13.40 Z" fill="currentColor" opacity=".4" />
        <path d="M16.68 11.30 Q17.54 10.80 18.40 11.30 L22.05 13.40 Q22.91 13.90 22.91 14.89 L22.91 19.11 Q22.91 20.10 22.05 20.60 L18.40 22.70 Q17.54 23.20 16.68 22.70 L13.03 20.60 Q12.17 20.10 12.17 19.11 L12.17 14.89 Q12.17 13.90 13.03 13.40 Z" fill="currentColor" opacity=".4" />
      </svg>
      Hivemind
    </a>
    <nav class="links" aria-label="Main">
      <a href="#agents">Agents</a>
      <a href="#plugins">Plugins</a>
      <a href="#elsewhere">Machines and phone</a>
      <a href="#faq">Questions</a>
      <a href={link('guide/')}>Docs</a>
      <a href={repo}>GitHub</a>
    </nav>
    <a class="btn small" href="#download">Download</a>
  </div>
</header>

<main id="main">

  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <h1>Your agents build the workspace they work in.</h1>
        <p class="lede">Run every coding agent side by side, from Claude and Codex to the one that ships tomorrow, and have them write your widgets, tools and views.</p>
        <div class="hero-act">
          <div class="install">
            <code>{install}</code>
            <button class="copy" type="button" data-copy={install} aria-label="Copy the install command">Copy</button>
          </div>
          <a class="btn primary" href="#download">Download</a>
        </div>
        <p class="fine">MIT licensed, on your computer, no account.</p>
      </div>
      <figure class="hero-media">
        <Loop name="hero" eager
          alt="The Hivemind app: an agent's terminal asking to edit a file, and above it a Progress widget an agent keeps up to date, 3 of 4 done." />
      </figure>
    </div>
  </section>

  <section class="band" id="agents" aria-labelledby="agents-h">
    <div class="wrap">
      <div class="head">
        <h2 id="agents-h">Every coding agent, even the one that ships tomorrow</h2>
        <p class="sub">Install an agent's CLI and it is on the board. For one Hivemind has never seen, your agent reads its <code>--help</code> and writes the file that teaches Hivemind to run it.</p>
      </div>
      <ul class="agents">
        {agents.map((a) => (
          <li>
            {a.icon
              ? <svg viewBox={a.icon.viewBox} width="20" height="20" fill="currentColor" fill-rule={a.icon.fillRule} aria-hidden="true">{a.icon.paths.map((d) => <path d={d} />)}</svg>
              : <span class="mono-mark" aria-hidden="true">{a.label.slice(0, 1)}</span>}
            <span class="a-name">{a.label}</span>
            <code class="a-id">{a.id}</code>
          </li>
        ))}
        <li class="a-next">
          <span class="mono-mark" aria-hidden="true">+</span>
          <a class="a-name" href={link('guide/agent-providers/')}>Any other</a>
          <code class="a-id">your agent adds it</code>
        </li>
      </ul>
    </div>
  </section>

  <section class="band" id="plugins" aria-labelledby="plugins-h">
    <div class="wrap">
      <div class="head">
        <h2 id="plugins-h">Widgets, tools and views, written by your agent</h2>
        <p class="sub"><code>hive widgets new</code> writes a starter and a <code>PROMPT.md</code>; hand the folder to your agent.</p>
      </div>

      <div class="kinds">
        <article class="kind">
          <Loop name="widgets" fallback={shot('showcase/waiting-on-you-board.webp', 1600, 1000)}
            alt="The Waiting on you widget at the top of the canvas: 2 agents waiting on you, docs-utils for 11 s and binding-test for 9 s." />
          <div class="kind-copy">
            <h3>Widget</h3>
            <p>A small live box above every view, with no network and no files.</p>
            <a href={link('guide/widgets/')}>Make a widget</a>
          </div>
        </article>
        <article class="kind">
          <Loop name="tools" fallback={shot('showcase/flaky-tests-board.webp', 1600, 1000)}
            alt="The Flaky tests tool on the canvas: five tests over 8 runs, two marked flaky, each with Ask an agent to fix." />
          <div class="kind-copy">
            <h3>Tool</h3>
            <p>A kind of tile with the app's access, so it arrives switched off.</p>
            <a href={link('guide/tool-plugins/')}>Make a tool</a>
          </div>
        </article>
        <article class="kind">
          <Loop name="views" fallback={shot('showcase/constellation-board.webp', 1600, 1000)}
            alt="The Constellation view: each frame a star, its agents lights on orbits coloured by what they are doing." />
          <div class="kind-copy">
            <h3>View</h3>
            <p>Draws the whole screen, sandboxed, around the real terminals. Canvas and Windows come with the app.</p>
            <a href={link('guide/views/')}>Make a view</a>
          </div>
        </article>
      </div>

      <div class="examples">
        <div class="ex-head">
          <h3>Examples to start from</h3>
          <p>On <a href={HIVEHUB}>HiveHub</a>, published from <a href="https://github.com/dip497/hivemind-plugins">hivemind-plugins</a>: install one from Settings ▸ Plugins. The agents in the pictures are stand-ins.</p>
        </div>
        {examples.map((group) => (
          <div class="ex-group">
            <h4>{group.kind}</h4>
            <ul class={`ex-grid ${group.fit}`}>
              {group.items.map((e) => (
                <li>
                  <img src={link(`shots/showcase/${e.id}.webp`)} width={e.w ?? 800} height={e.h ?? 500} loading="lazy" decoding="async" alt={e.alt ?? `The ${e.name} ${group.one}.`} />
                  <a href={`${HIVEHUB}p/${group.scope}${e.id}`}><code>{e.id}</code></a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="after"><a href={HIVEHUB}>Browse the plugins on HiveHub</a></p>
    </div>
  </section>

  <section class="band" id="waiting" aria-labelledby="waiting-h">
    <div class="wrap">
      <div class="head">
        <h2 id="waiting-h">See which agent is waiting on you, and answer it</h2>
        <p class="sub">Every tile shows whether its agent is working, finished or waiting on you.</p>
      </div>
      <figure class="shot">
        <img src={link('shots/showcase/agents-by-state.webp')} width="800" height="500" loading="lazy" decoding="async"
          alt="Agents by state: docs-utils and binding-test wait on you for permission, five are working, three are ready, and docs-utils' prompt is open beside them." />
      </figure>
      <p class="after"><code>hive ctl spawn --supervise all</code> sends a Claude or Kiro worker's permission prompts to you. <a href={link('guide/agent-workflows/')}>Agents running agents</a></p>
    </div>
  </section>

  <section class="band" id="elsewhere" aria-labelledby="elsewhere-h">
    <div class="wrap">
      <div class="head">
        <h2 id="elsewhere-h">On your other machines, and on your other screens</h2>
      </div>

      <div class="row">
        <Loop name="machines"
          alt="Agents in frames, one of them on a machine reached over ssh." />
        <div class="row-copy">
          <h3>Machines over ssh</h3>
          <p>Open a folder on a Linux machine over your own ssh; its terminals and agents run there.</p>
          <pre class="cmd"><span class="w">$</span> hive machine add dev@build-box <span class="g">--label</span> build <span class="g">--install</span></pre>
          <a href={link('guide/machines/')}>Add a machine</a>
        </div>
      </div>

      <div class="row flip">
        <Loop name="devices"
          alt="The same agent's permission prompt on the desktop, in a browser tab and on a phone." />
        <div class="row-copy">
          <h3>The same workspace on desktop, browser and phone</h3>
          <p>The app, a browser tab on the same computer, or your phone.</p>
          <a href={link('guide/phone/#the-whole-app-in-a-browser-tab')}>Open it in a browser</a>
        </div>
      </div>

      <div class="row" id="phone">
        <Loop name="phone" fallback={{ file: 'phone-home.webp', width: 780, height: 1688, fit: 'contain' }}
          alt="The phone page's Home: a permission card for Editing Nav.tsx with Allow and Deny." />
        <div class="row-copy">
          <h3>Answer from your phone</h3>
          <p>Answer your agents from your phone's browser, through a <code>hive-net</code> server of yours.</p>
          <a href={link('guide/phone/')}>Set up the phone page</a>
        </div>
      </div>

      <div class="row flip">
        <Loop name="join"
          alt="A shared workspace open in a second person's Hivemind." />
        <div class="row-copy">
          <h3>Someone joins your workspace</h3>
          <p>Send an invite link; if both screens show the same three words, you choose what they may do.</p>
          <pre class="cmd"><span class="w">$</span> hive share ~/work/api <span class="g">--role</span> edit <span class="g">--uses</span> 3 <span class="g">--expires</span> 2d</pre>
          <a href={link('guide/multiplayer/')}>Share a workspace</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="yours" aria-labelledby="yours-h">
    <div class="wrap">
      <div class="head">
        <h2 id="yours-h">Yours, not ours</h2>
        <p class="sub">Your agents, your keys, your machines. No account and no server of ours.</p>
      </div>
      <div class="yours">
        <figure class="map" aria-labelledby="map-cap">
          <svg viewBox="0 0 560 300" role="img" aria-labelledby="map-cap">
            <g class="m-box"><rect x="1" y="20" width="168" height="84" rx="8" /></g>
            <text class="m-lab" x="16" y="46">YOUR PHONE</text>
            <text class="m-txt" x="16" y="72">phone page</text>
            <text class="m-dim" x="16" y="92">in its browser</text>

            <g class="m-box"><rect x="196" y="20" width="168" height="84" rx="8" /></g>
            <text class="m-lab" x="211" y="46">YOUR SERVER</text>
            <text class="m-txt" x="211" y="72">hive-net serve</text>
            <text class="m-dim" x="211" y="92">reads none of it</text>

            <g class="m-box"><rect x="391" y="20" width="168" height="84" rx="8" /></g>
            <text class="m-lab" x="406" y="46">YOUR COMPUTER</text>
            <text class="m-txt" x="406" y="72">Hivemind</text>
            <circle class="m-dot ok" cx="410" cy="88" r="4" /><circle class="m-dot work" cx="424" cy="88" r="4" /><circle class="m-dot wait" cx="438" cy="88" r="4" />

            <path class="m-line" d="M170 62 H195" /><path class="m-line" d="M365 62 H390" />
            <text class="m-dim" x="170" y="128">https</text>
            <text class="m-dim" x="300" y="128">end-to-end encrypted</text>

            <g class="m-box"><rect x="391" y="196" width="168" height="84" rx="8" /></g>
            <text class="m-lab" x="406" y="222">YOUR MACHINES</text>
            <text class="m-txt" x="406" y="248">hive daemon</text>
            <text class="m-dim" x="406" y="268">over your ssh</text>
            <path class="m-line" d="M475 105 V195" />
          </svg>
          <figcaption id="map-cap">Everything in the path is a machine you run.</figcaption>
        </figure>
        <dl class="facts">
          <dt>MIT licensed</dt>
          <dd>The app, <code>hive</code> and <code>hive-net</code>, in one repository. <a href={repo}>Read the source</a>.</dd>
          <dt>Your own server for the phone</dt>
          <dd><code>hive-net</code> relays traffic it cannot read. <a href={link('guide/self-hosting/')}>Run your own</a>.</dd>
          <dt>What a plugin can touch</dt>
          <dd>Views and widgets have no files or network; a tool stays off until you switch it on.</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="band" id="numbers" aria-labelledby="numbers-h">
    <div class="wrap">
      <div class="head">
        <h2 id="numbers-h">Measured, with the load it ran under</h2>
        <p class="sub">From the <a href={changelog}>2026.10.3 changelog</a>, on 16 CPUs.</p>
      </div>
      <table class="nums">
        <thead><tr><th scope="col">Result</th><th scope="col">What was measured</th><th scope="col">Load</th></tr></thead>
        <tbody>
          <tr><td>3–7 ms</td><td>Key echo while another terminal prints 10 MB (was 162 ms).</td><td>22–50</td></tr>
          <tr><td>11–39 ms</td><td>Longest daemon pause with 30 terminals on screen (was 2.3–2.7 s).</td><td>12–16</td></tr>
          <tr><td>0.23 ms</td><td>Cost of one agent event, with 72 or 600 agents (was 1.9 ms).</td><td>about 100</td></tr>
          <tr><td>10 ms</td><td>Your phone's agent list for 600 agents (was 1.6 s).</td><td>about 80</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="band" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="head"><h2 id="faq-h">Questions</h2></div>
      <dl class="faq">
        <dt>Why not roll my own?</dt>
        <dd>You can, here. Hivemind keeps the terminals and agents alive; you write the rest.</dd>
        <dt>Does my code go anywhere?</dt>
        <dd>No. Agents run on your computer or your ssh machines.</dd>
        <dt>Which platforms does it run on?</dt>
        <dd>Linux x86_64, macOS on Apple Silicon and Windows x64; an Intel Mac or Linux arm64 builds with <code>--dev</code>.</dd>
        <dt>Is there a phone app?</dt>
        <dd>Not a published one; the phone page runs in your browser.</dd>
        <dt>Which agents work with it?</dt>
        <dd>Any coding agent that runs in a terminal. The ones below are found on their own; your agent adds any other in one file.</dd>
      </dl>
    </div>
  </section>

  <section class="band dl" id="download" aria-labelledby="download-h">
    <div class="wrap">
      <div class="head">
        <h2 id="download-h">Download Hivemind</h2>
        <p class="sub">One command installs the app and the <code>hive</code> CLI.</p>
      </div>
      <div class="dl-grid">
        <article class="dl-card" data-os="linux">
          <h3>Linux <span class="dl-arch">x86_64</span></h3>
          <div class="install"><code>{install}</code>
            <button class="copy" type="button" data-copy={install} aria-label="Copy the install command for Linux">Copy</button></div>
          <a class="dl-file" href={dl('linux')}>Or take the AppImage</a>
        </article>
        <article class="dl-card" data-os="macos">
          <h3>macOS <span class="dl-arch">Apple Silicon</span></h3>
          <div class="install"><code>{install}</code>
            <button class="copy" type="button" data-copy={install} aria-label="Copy the install command for macOS">Copy</button></div>
          <a class="dl-file" href={dl('macos')}>Or take the .app</a>
        </article>
        <article class="dl-card" data-os="windows">
          <h3>Windows <span class="dl-arch">x64</span></h3>
          <div class="install"><code>{installPs}</code>
            <button class="copy" type="button" data-copy={installPs} aria-label="Copy the install command for Windows">Copy</button></div>
          <p class="dl-note">Run least so far.</p>
        </article>
      </div>
      <p class="dl-more">CLI only: <a href={dl('cli-linux-x86_64')}>Linux x86_64</a>, <a href={dl('cli-linux-arm64')}>Linux arm64</a>, <a href={dl('cli-macos-arm64')}>macOS</a>, <a href={dl('cli-windows-x64')}>Windows</a>. <a href={dl('notes')}>Release notes</a>.</p>
    </div>
  </section>

  <section class="close">
    <div class="wrap close-in">
      <h2>Start with one repo.</h2>
      <div class="cta">
        <a class="btn primary" href="#download">Download</a>
        <a class="btn ghost" href={link('guide/getting-started/')}>Read the quickstart</a>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-in">
    <span>Hivemind, MIT licensed.</span>
    <nav aria-label="Footer">
      <a href={link('guide/')}>Docs</a>
      <a href={link('guide/cli/')}>CLI reference</a>
      <a href={HIVEHUB}>HiveHub</a>
      <a href={link('llms.txt')}>For agents</a>
      <a href={repo}>GitHub</a>
    </nav>
  </div>
</footer>

<script is:inline>
  // This computer's card goes first; a wrong guess costs nothing, and no script loses nothing.
  (() => {
    const grid = document.querySelector('.dl-grid');
    if (!grid) return;
    const ua = navigator.userAgent;
    const os = /Windows|Win32|Win64/.test(ua) ? 'windows' : /Mac OS X|Macintosh/.test(ua) ? 'macos' : /Linux|X11|CrOS/.test(ua) ? 'linux' : null;
    const mine = os && grid.querySelector(`.dl-card[data-os="${os}"]`);
    if (!mine) return;
    mine.dataset.me = '1';
    mine.querySelector('h3')?.insertAdjacentHTML('beforeend', ' <span class="dl-me">this computer</span>');
    grid.prepend(mine);
  })();
  document.querySelectorAll('.copy').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy);
        const was = b.textContent;
        b.textContent = 'Copied'; b.dataset.done = '';
        setTimeout(() => { b.textContent = was; delete b.dataset.done; }, 1600);
      } catch { /* clipboard blocked: the command is still selectable */ }
    });
  });
</script>

<style is:global>
  @import "../styles/workspace.css";

  :root{
    --bg:   oklch(0.165 0.004 250);
    --bg2:  oklch(0.19 0.004 250);
    --bg3:  oklch(0.215 0.005 250);
    --line: oklch(0.262 0.006 250);
    --line2:oklch(0.34 0.008 250);
    --fg:   oklch(0.93 0.003 250);
    --fg2:  oklch(0.83 0.005 250);
    --fg3:  oklch(0.70 0.008 250);
    --gut: 32px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;scroll-padding-top:72px;scrollbar-color:var(--line2) var(--bg)}
  body{margin:0;background:var(--bg);color:var(--fg2);font-family:var(--f);font-size:16px;line-height:1.6;
    -webkit-font-smoothing:antialiased;caret-color:var(--idle)}
  a{color:inherit;text-underline-offset:3px;text-decoration-thickness:1px}
  ::selection{background:color-mix(in oklab,var(--idle) 35%,transparent);color:var(--fg)}
  :focus-visible{outline:2px solid var(--idle);outline-offset:3px;border-radius:3px}
  .skip{position:absolute;left:16px;top:-60px;background:var(--fg);color:var(--bg);padding:10px 14px;z-index:200;border-radius:5px}
  .skip:focus{top:12px}
  .wrap{max-width:1240px;margin:0 auto;padding:0 var(--gut)}

  h1,h2,h3{color:var(--fg);margin:0;text-wrap:balance;font-weight:600}
  h1{font-size:clamp(38px,5.4vw,68px);line-height:1.02;letter-spacing:-.034em;max-width:15ch}
  h2{font-size:clamp(26px,2.9vw,38px);line-height:1.12;letter-spacing:-.026em;max-width:24ch}
  h3{font-size:18px;line-height:1.3;letter-spacing:-.012em}
  p{margin:0}
  code,kbd,.cmd{font-family:var(--f-m)}
  :not(pre)>code{font-size:.9em;color:var(--fg);white-space:nowrap}
  kbd{font-size:.82em;border:1px solid var(--line2);border-bottom-width:2px;border-radius:4px;padding:0 5px;color:var(--fg)}
  .sub{font-size:17px;line-height:1.6;color:var(--fg3);max-width:62ch;margin-top:16px;text-wrap:pretty}
  .sub a,.facts a,.dl-more a,.after a,.kind-copy a,.row-copy a{color:var(--fg);text-decoration:underline;text-decoration-color:var(--line2)}
  @media (hover:hover) and (pointer:fine){
    .sub a:hover,.facts a:hover,.dl-more a:hover,.after a:hover,.kind-copy a:hover,.row-copy a:hover{text-decoration-color:var(--fg2)}
  }

  /* Chrome: a hairline under an opaque bar, as the app draws its own. */
  .nav{position:sticky;top:0;z-index:50;background:var(--bg);border-bottom:1px solid var(--line)}
  .nav-in{max-width:1240px;margin:0 auto;padding:0 var(--gut);height:56px;display:flex;align-items:center;gap:24px}
  .brand{display:flex;align-items:center;gap:9px;font-weight:600;font-size:15px;color:var(--fg);text-decoration:none;letter-spacing:-.01em}
  .links{display:flex;gap:22px;margin-left:auto;font-size:14px}
  .links a{color:var(--fg3);text-decoration:none;transition:color var(--d2) ease}
  @media (hover:hover) and (pointer:fine){ .links a:hover{color:var(--fg)} }

  .btn{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 18px;
    border-radius:6px;font-size:14px;font-weight:500;text-decoration:none;border:1px solid transparent;white-space:nowrap;
    transition-property:background-color,border-color,transform;transition-duration:var(--d2);transition-timing-function:ease}
  .btn.small{height:32px;padding:0 13px;font-size:13px;border-color:var(--line2);color:var(--fg)}
  .btn:active{transform:scale(.97)}
  .btn.primary{background:var(--fg);color:var(--bg)}
  .btn.ghost{border-color:var(--line2);color:var(--fg)}
  @media (hover:hover) and (pointer:fine){
    .btn.primary:hover{background:var(--fg2)}
    .btn.ghost:hover,.btn.small:hover{border-color:var(--fg3)}
  }

  /* The install line is a terminal, so it is drawn as one. */
  .install{display:flex;align-items:center;gap:12px;min-width:0;height:40px;padding:0 6px 0 14px;
    background:var(--bg2);border:1px solid var(--line);border-radius:6px;font-size:13px}
  .install code{color:var(--fg2);white-space:nowrap;overflow-x:auto;scrollbar-width:none;min-width:0}
  .install code::-webkit-scrollbar{display:none}
  .install code::before{content:"$ ";color:var(--fg3)}
  .copy{margin-left:auto;flex-shrink:0;font:500 12px/1 var(--f-m);cursor:pointer;color:var(--fg3);background:transparent;
    border:1px solid var(--line2);border-radius:4px;padding:6px 10px;transition:color var(--d2) ease,border-color var(--d2) ease}
  .copy[data-done]{color:var(--ok);border-color:color-mix(in oklab,var(--ok) 45%,transparent)}
  @media (hover:hover) and (pointer:fine){ .copy:hover{color:var(--fg);border-color:var(--fg3)} }

  /* Hero: the sentence, the command, then the product as large as the page allows. */
  .hero{padding:96px 0 112px}
  .hero-copy{max-width:760px}
  .lede{font-size:clamp(18px,1.45vw,21px);line-height:1.5;color:var(--fg2);max-width:52ch;margin-top:24px;text-wrap:pretty}
  .hero-act{display:flex;gap:10px;margin-top:36px;max-width:640px}
  .hero-act .install{flex:1 1 auto}
  .fine{margin-top:14px;font-size:14px;color:var(--fg3)}
  .hero-media{margin:72px 0 0}

  /* Sections: one ground, divided by hairlines. */
  .band{padding:120px 0;border-top:1px solid var(--line)}
  .head{margin-bottom:48px}
  .after{margin-top:28px;font-size:15px;color:var(--fg3)}

  .cmd{margin:0;font-size:12.5px;line-height:1.8;color:var(--fg2);background:var(--bg2);border:1px solid var(--line);
    border-radius:6px;padding:14px 16px;white-space:pre-wrap;word-break:keep-all;overflow-wrap:normal;min-width:0}
  .cmd .w,.cmd .c{color:var(--fg3)}
  .cmd .g{color:var(--idle);white-space:nowrap}
  .cmd .s{color:var(--ok)}

  /* Agents: the same marks the app draws, one tile each. */
  .agents{list-style:none;margin:0;padding:0;display:grid;border:1px solid var(--line);
    border-radius:8px;overflow:hidden;grid-template-columns:repeat(auto-fill,minmax(176px,1fr))}
  .agents li{display:grid;grid-template-columns:20px minmax(0,1fr);column-gap:12px;align-items:center;padding:16px 18px;
    margin:0 -1px -1px 0;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .agents svg{color:var(--fg)}
  .mono-mark{width:20px;height:20px;display:grid;place-items:center;border:1px solid var(--line2);border-radius:4px;
    font:500 11px/1 var(--f-m);color:var(--fg)}
  .a-name{color:var(--fg);font-size:15px;font-weight:500}
  .a-id{grid-column:2;font-size:12px;color:var(--fg3) !important}
  .a-next .mono-mark{border-style:dashed}
  .a-next .a-name{text-decoration:underline;text-decoration-color:var(--line2)}
  .a-next .a-name:hover{text-decoration-color:var(--fg2)}

  /* Plugins: three kinds, each a clip beside what it is. */
  .kinds{display:grid;gap:72px}
  .kind{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:48px;align-items:center}
  .kind:nth-child(2){grid-template-columns:minmax(0,1fr) minmax(0,1.6fr)}
  .kind:nth-child(2) > .loop{order:2}
  .kind-copy{display:grid;gap:12px;justify-items:start;font-size:16px;color:var(--fg3);max-width:44ch}
  .kind-copy h3{font-family:var(--f-m);font-size:13px;font-weight:500;letter-spacing:.02em;color:var(--fg2)}
  .kind-copy > p:first-of-type{font-size:19px;line-height:1.45;color:var(--fg);letter-spacing:-.01em}

  /* Examples: real screenshots, grouped by kind. */
  .examples{margin-top:96px;padding-top:56px;border-top:1px solid var(--line)}
  .ex-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:48px;align-items:baseline;margin-bottom:40px}
  .ex-head h3{font-size:24px;letter-spacing:-.02em}
  .ex-head p{font-size:15.5px;color:var(--fg3);max-width:62ch}
  .ex-head a{color:var(--fg);text-decoration:underline;text-decoration-color:var(--line2)}
  .ex-group + .ex-group{margin-top:48px}
  .ex-group h4{margin:0 0 16px;font:500 13px var(--f-m);color:var(--fg2)}
  .ex-grid{list-style:none;margin:0;padding:0;display:grid;gap:32px 20px;grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}
  .ex-grid li{display:grid;gap:8px;align-content:start}
  .ex-grid img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:top;
    border:1px solid var(--line);border-radius:8px;background:#0b0d10}
  .ex-grid.contain img{object-fit:contain;padding:10px}
  .ex-grid code{font-size:12.5px;color:var(--fg);margin-top:4px}

  .shot{margin:0}
  .shot img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:12px;background:#0b0d10}

  /* Elsewhere: a clip and what it shows, alternating sides. */
  .row{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:48px;align-items:center}
  .row + .row{margin-top:96px}
  .row.flip{grid-template-columns:minmax(0,1fr) minmax(0,1.5fr)}
  .row.flip > .row-copy{order:-1}
  .row-copy{display:grid;gap:14px;justify-items:start;font-size:16px;color:var(--fg3)}
  .row-copy p{max-width:50ch}
  .row-copy .cmd{justify-self:stretch}

  /* Yours: a map of where things run, and the facts beside it. */
  .yours{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:start}
  .map{margin:0}
  .map svg{width:100%;height:auto;display:block}
  .m-box rect{fill:var(--bg2);stroke:var(--line2)}
  .m-line{stroke:var(--fg3);stroke-width:1;fill:none}
  .m-lab{font:500 10px var(--f-m);letter-spacing:.08em;fill:var(--fg3)}
  .m-txt{font:500 15px var(--f);fill:var(--fg)}
  .m-dim{font:400 11px var(--f-m);fill:var(--fg3)}
  .m-dot.ok{fill:var(--ok)} .m-dot.work{fill:var(--working)} .m-dot.wait{fill:var(--idle)}
  .map figcaption{margin-top:14px;font-size:14px;color:var(--fg3)}
  .facts{margin:0}
  .facts dt{color:var(--fg);font-weight:500;padding-top:20px;border-top:1px solid var(--line)}
  .facts dt:first-child{padding-top:0;border-top:0}
  .facts dd{margin:6px 0 20px;color:var(--fg3);font-size:15.5px}

  /* Numbers: a table, because they are data. */
  .nums{width:100%;border-collapse:collapse;font-size:15px}
  .nums th{text-align:left;font:500 12px var(--f-m);color:var(--fg3);padding:0 16px 12px 0;border-bottom:1px solid var(--line2)}
  .nums td{padding:18px 16px 18px 0;border-bottom:1px solid var(--line);vertical-align:baseline;color:var(--fg3)}
  .nums td:first-child{font:500 22px/1.2 var(--f-m);color:var(--fg);white-space:nowrap;font-variant-numeric:tabular-nums;width:9.5em}
  .nums td:last-child{font-family:var(--f-m);font-size:13px;white-space:nowrap;text-align:right;padding-right:0}
  .nums th:last-child{text-align:right;padding-right:0}

  .faq{margin:0;max-width:780px}
  .faq dt{color:var(--fg);font-weight:500;font-size:18px;padding-top:24px;border-top:1px solid var(--line)}
  .faq dt:first-child{padding-top:0;border-top:0}
  .faq dd{margin:8px 0 24px;color:var(--fg3);font-size:16px;max-width:66ch}

  .dl-grid{display:grid;gap:12px;margin-bottom:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}
  .dl-card{border:1px solid var(--line);border-radius:8px;padding:18px;background:var(--bg)}
  .dl-card[data-me="1"]{border-color:var(--line2);background:var(--bg2)}
  .dl-card h3{margin:0 0 12px;font-size:15px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
  .dl-arch,.dl-me{font:400 12px var(--f-m);color:var(--fg3)}
  .dl-me{color:var(--ok)}
  .dl-file{display:inline-block;margin-top:12px;font-size:13px;color:var(--fg2)}
  .dl-note{margin-top:12px;font-size:13px;color:var(--fg3)}
  .dl-more{font-size:14px;color:var(--fg3);max-width:78ch}

  .close{padding:96px 0;border-top:1px solid var(--line)}
  .close-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px}
  .cta{display:flex;flex-wrap:wrap;gap:10px}
  .foot{border-top:1px solid var(--line);padding:28px 0;font-size:14px;color:var(--fg3)}
  .foot-in{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;justify-content:space-between}
  .foot nav{display:flex;flex-wrap:wrap;gap:8px 22px}
  .foot a{color:var(--fg2);text-decoration:none}
  @media (hover:hover) and (pointer:fine){ .foot a:hover{color:var(--fg)} }

  @media (max-width:960px){
    .kind,.row,.yours,.ex-head{grid-template-columns:minmax(0,1fr);gap:28px}
    .kind:nth-child(2),.row.flip{grid-template-columns:minmax(0,1fr)}
    .kind:nth-child(2) > .loop{order:0}
    .row.flip > .row-copy{order:0}
    .kinds{gap:64px}
    .row + .row{margin-top:72px}
  }
  @media (max-width:640px){
    :root{--gut:16px}
    .nav-in{height:auto;min-height:52px;padding:8px var(--gut);flex-wrap:wrap;gap:6px 14px}
    .links{order:3;width:100%;margin:0 calc(var(--gut) * -1);padding:4px var(--gut) 6px;overflow-x:auto;gap:18px;scrollbar-width:none}
    .links::-webkit-scrollbar{display:none}
    .links a{white-space:nowrap}
    .nav-in > .btn{margin-left:auto}
    .hero{padding:56px 0 72px}
    .hero-act{flex-direction:column}
    .hero-act .btn{align-self:flex-start}
    .hero-media{margin-top:48px}
    .band{padding:80px 0}
    .head{margin-bottom:32px}
    .sub{font-size:16px}
    .agents{grid-template-columns:repeat(2,minmax(0,1fr))}
    .agents li{padding:14px}
    .ex-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}
    .examples{margin-top:72px}
    .nums thead{display:none}
    .nums tr{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;padding:16px 0;border-bottom:1px solid var(--line)}
    .nums td{padding:0;border:0}
    .nums td:first-child{width:auto}
    .nums td:nth-child(2){grid-column:1 / -1;grid-row:2}
    .nums td:last-child{text-align:right}
    .nums td:last-child::before{content:"load ";color:var(--fg3)}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *{transition-duration:1ms !important}
    .btn:active{transform:none}
  }
</style>
</body>
</html>
