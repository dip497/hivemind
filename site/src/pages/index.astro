---
import { HIVEHUB } from "../hivehub";
import SchoolOfAgents from '../components/SchoolOfAgents.astro';
import Fonts from '../components/Fonts.astro';
import { heroStill, HERO_SIZES } from '../lib/hero-images';
import icons from '../generated/agent-icons.json';
import tokens from '../generated/tokens.json';
import { resolve } from '../lib/tokens';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${path}`;
// The title and description are what a search result shows: they say what Hivemind is and name
// the agents people search for, so "hivemind" plus an agent's name finds this page.
const title = 'Hivemind: run Claude Code, Codex and every coding agent side by side';
const description =
  'Free, open-source app that runs Claude Code, Codex, opencode and any coding agent side by side in real terminals. Your agents build its views and tools. MIT, no account.';
const repo = 'https://github.com/dip497/hivemind';
const changelog = `${repo}/blob/main/CHANGELOG.md#2026103--2026-10-18`;
const install = 'bash <(curl -fsSL https://hivemind.griiken.com/install.sh)';
const installPs = 'irm https://hivemind.griiken.com/install.ps1 | iex';
// Every file link goes through /download/<key>, which the server sends on to the current release.
const dl = (key: string) => `${base}/download/${key}`;
const agents = icons.agents;
const ogImage = new URL(link('shots/og.jpg'), Astro.site).href;
// The hero's still is the largest paint; the head asks for it before anything else.
const heroImage = await heroStill();
const home = new URL(link(''), Astro.site).href;

// The agents people search for by name, as the generated list spells them, while it still has them.
const wellKnown = ['Claude', 'Codex', 'opencode', 'Cursor', 'Copilot', 'Amp', 'Aider']
  .filter((name) => agents.some((a) => a.label === name))
  .map((name) => (name === 'Claude' ? 'Claude Code' : name));

// The questions, once: the page shows them and the structured data below hands them to search
// and answer engines word for word. Answers are HTML; the structured data gets their text.
const faq = [
  { q: 'What is Hivemind?', a: 'A free, open-source app that runs your coding agents, such as Claude Code, Codex and opencode, side by side, each in a real terminal on one canvas. Your agents add the views, widgets and tools around them.' },
  { q: 'Is Hivemind free?', a: 'Yes. It is open source under the MIT license and needs no account. The agents you run in it are separate programs, with their own accounts and prices.' },
  { q: 'Which coding agents does it run?', a: `Any coding agent with a CLI. It finds ${agents.length} on its own, among them ${wellKnown.join(', ')}, and your agent can <a href="${link('guide/agent-providers/')}">teach it a new one</a>.` },
  { q: 'Why not roll my own?', a: 'You can, here. Hivemind keeps the terminals and agents alive; you and your agents write the rest.' },
  { q: 'Does my code go anywhere?', a: 'No. Agents run on your computer or your ssh machines.' },
  { q: 'What can a plugin touch?', a: 'Views and widgets have no files and no network. A tool stays off until you switch it on.' },
  { q: 'Which platforms does it run on?', a: 'Linux x86_64, macOS on Apple Silicon and Windows x64. An Intel Mac or Linux arm64 builds with <code>--dev</code>.' },
  { q: 'Is there a phone app?', a: 'Not a published one. The phone page runs in your phone\'s browser.' },
];
const text = (html: string) => html.replace(/<[^>]+>/g, '');

// Who and what this site is about, for search engines and answer engines: the app, the website
// and the project behind them, tied to the same GitHub repository and HiveHub.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${home}#organization`,
      name: 'Hivemind',
      url: home,
      logo: new URL(link('icon.png'), Astro.site).href,
      sameAs: [repo, HIVEHUB],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: 'Hivemind',
      alternateName: 'Hivemind for coding agents',
      url: home,
      inLanguage: 'en',
      publisher: { '@id': `${home}#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${home}#software`,
      name: 'Hivemind',
      description: text(faq[0].a),
      url: home,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Workspace for AI coding agents',
      operatingSystem: 'Linux, macOS, Windows',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isAccessibleForFree: true,
      license: 'https://opensource.org/licenses/MIT',
      downloadUrl: new URL(link('download'), Astro.site).href,
      installUrl: new URL(link('guide/install/'), Astro.site).href,
      softwareHelp: { '@type': 'CreativeWork', url: new URL(link('guide/'), Astro.site).href },
      image: ogImage,
      screenshot: ogImage,
      publisher: { '@id': `${home}#organization` },
      sameAs: [repo],
    },
    {
      '@type': 'FAQPage',
      '@id': `${home}#faq`,
      mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: text(a) } })),
    },
  ],
};

// The page paints in the app's own colours, read from the app's stylesheet at build time.
const app = tokens.tokens as Record<string, { value: string }>;
const tk = (name: string) => resolve(resolve(app[name].value));
const appColours = `:root{--bg:${tk('color-bg')};--bg2:${tk('color-bg2')};--bg3:${tk('color-bg3')};--line:${tk('color-line')};--line2:${tk('color-line2')};--fg:${tk('color-fg')};--fg2:${tk('color-fg2')};--fg3:${tk('color-fg3')};--term:${tk('color-terminal-bg')};--grid-dot:${tk('color-grid-dot')};--st-working:${tk('color-status-working')};--st-attention:${tk('color-status-attention')};--st-done:${tk('color-status-done')};--st-idle:${tk('color-status-idle')};--st-failed:${tk('color-status-failed')};--ease:${tk('hm-ease-out')};--sh2:${tk('hm-shadow-2')};--sh3:${tk('hm-shadow-3')};--note-blue:${tk('color-note-blue')};--note-violet:${tk('color-note-violet')}}`;

const views = [
  { id: 'agents-by-state', name: 'Agents by state', line: 'Columns of who is working, waiting and ready.' },
  { id: 'timeline', name: 'Timeline', line: 'Today, one lane per agent.' },
  { id: 'constellation', name: 'Constellation', line: 'Each project a star, its agents in orbit.' },
  { id: 'workspace-map', name: 'Workspace map', line: 'Projects, agents and issues as one tree.' },
];
const widgets = [
  { id: 'test-meter', name: 'Test meter', w: 592, h: 477 },
  { id: 'agent-pulse', name: 'Agent pulse', w: 592, h: 354 },
  { id: 'launchpad', name: 'Launchpad', w: 592, h: 476 },
];
const code: Record<string, [string, string][]> = {
  ctl: [
    ['c', '# from inside any agent: hive ctl is on its PATH'],
    ['p', 'hive ctl spawn --agent codex --prompt "Fix the flaky cart test"'],
    ['p', 'hive ctl read $TILE    # wait for its reply'],
    ['p', 'hive ctl workflow --items "api||web||cli" --prompt "Review {item}"'],
    ['p', 'hive plugins new tool flaky-tests'],
    ['p', 'hive plugins install @dip497/timeline'],
  ],
  ts: [
    ['k', 'import { connect } from "hivemind-api";'],
    ['', ''],
    ['', 'const hive = await connect();'],
    ['', 'const { tile } = await hive.agents.start({ program: "claude", prompt: "Run the tests" });'],
    ['', 'const reply = await hive.agents.read(tile);'],
    ['', 'console.log(reply.text);'],
  ],
  py: [
    ['k', 'from hivemind_api import connect'],
    ['', ''],
    ['', 'with connect() as hive:'],
    ['', '    tile = hive.agents.start({"program": "claude", "prompt": "Run the tests"})["tile"]'],
    ['', '    print(hive.agents.read(tile)["text"])'],
  ],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={home} />
  <meta name="theme-color" content="#111316" />
  <link rel="icon" href={link('favicon.svg')} />
  <link rel="alternate" type="text/plain" href={link('llms.txt')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={home} />
  <meta property="og:site_name" content="Hivemind" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Hivemind: coding agents side by side on one canvas" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}></script>
  <link rel="preload" as="image" type="image/avif" imagesrcset={heroImage.avif} imagesizes={HERO_SIZES} fetchpriority="high" />
  <Fonts />
  <style set:html={appColours}></style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="nav-in">
    <a class="brand" href={link('')} aria-label="Hivemind home">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M11.14 1.70 Q12 1.20 12.86 1.70 L16.51 3.80 Q17.37 4.30 17.37 5.29 L17.37 9.51 Q17.37 10.50 16.51 11 L12.86 13.10 Q12 13.60 11.14 13.10 L7.49 11 Q6.63 10.50 6.63 9.51 L6.63 5.29 Q6.63 4.30 7.49 3.80 Z" fill="currentColor" />
        <path d="M5.60 11.30 Q6.46 10.80 7.32 11.30 L10.97 13.40 Q11.83 13.90 11.83 14.89 L11.83 19.11 Q11.83 20.10 10.97 20.60 L7.32 22.70 Q6.46 23.20 5.60 22.70 L1.95 20.60 Q1.09 20.10 1.09 19.11 L1.09 14.89 Q1.09 13.90 1.95 13.40 Z" fill="currentColor" opacity=".4" />
        <path d="M16.68 11.30 Q17.54 10.80 18.40 11.30 L22.05 13.40 Q22.91 13.90 22.91 14.89 L22.91 19.11 Q22.91 20.10 22.05 20.60 L18.40 22.70 Q17.54 23.20 16.68 22.70 L13.03 20.60 Q12.17 20.10 12.17 19.11 L12.17 14.89 Q12.17 13.90 13.03 13.40 Z" fill="currentColor" opacity=".4" />
      </svg>
      Hivemind
    </a>
    <nav class="links" aria-label="Main">
      <a href="#views">Views</a>
      <a href="#plugins">Widgets and tools</a>
      <a href="#api">Agents and API</a>
      <a href="#reach">Anywhere</a>
      <a href={link('guide/')}>Docs</a>
      <a href={repo}>GitHub</a>
    </nav>
    <a class="btn small" href="#download">Download</a>
  </div>
</header>

<main id="main">

  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <i style="--x:-27;--y:3"></i><i style="--x:-26;--y:4"></i><i style="--x:-21;--y:11"></i>
      <i style="--x:24;--y:2"></i><i style="--x:25;--y:2"></i><i style="--x:25;--y:3"></i><i style="--x:27;--y:9"></i>
      <i style="--x:-6;--y:1"></i><i style="--x:13;--y:13"></i>
    </div>
    <div class="wrap">
      <div class="hero-copy">
        <div class="hero-say">
          <h1><span>Your agents build</span> the workspace they work in.</h1>
        </div>
        <div class="hero-do">
          <p class="lede">Every coding agent, in a real terminal. Ask one for a view, a widget or a tool, and it builds it into your workspace.</p>
          <div class="hero-act">
            <a class="btn primary" href="#download" data-dl-label>Download</a>
            <button class="btn ghost copy-cmd" type="button" data-copy={install} data-install data-label="Copied">Copy install command</button>
          </div>
        </div>
      </div>
      <SchoolOfAgents />
    </div>
  </section>

  <section class="band" id="views" aria-labelledby="views-h">
    <div class="wrap split views">
      <div class="head reveal">
        <h2 id="views-h">The canvas is only where it starts.</h2>
        <p class="sub">A view draws the whole screen around the same live terminals. Ask for one and your agent writes it, in a sandbox, for you alone.</p>
        <div class="vtabs" role="tablist" aria-label="Views written as plugins">
          {views.map((v, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-v={i}>
              <b>{v.name}</b><span>{v.line}</span>
            </button>
          ))}
        </div>
        <p class="links-row"><a href={link('guide/views/')}>Make a view</a><a href={HIVEHUB}>Views on HiveHub</a></p>
      </div>
      <div class="fan" data-fan>
        {views.map((v, i) => (
          <figure class="fan-card" data-i={i} data-pos={i}>
            <img src={link(`shots/showcase/${v.id}.webp`)} width="800" height="500" loading="lazy" decoding="async"
              alt={`The ${v.name} view, written as a plugin: ${v.line.toLowerCase()}`} />
            <figcaption><span>View</span>{v.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="plugins" aria-labelledby="plugins-h">
    <div class="wrap">
      <div class="head reveal center">
        <h2 id="plugins-h">Ask for a tool. It lands on the canvas, and stays up to date.</h2>
      </div>
      <div class="bento">
        <article class="b-card b-tool reveal">
          <img src={link('shots/showcase/flaky-tests-tool.webp')} width="950" height="340" loading="lazy" decoding="async"
            alt="The Flaky tests tool on the canvas: five tests over 8 runs, two marked flaky, each with Ask an agent to fix." />
          <div class="b-copy"><p class="b-k">Tool</p><p>A tile with the app's access, so it arrives switched off until you turn it on.</p></div>
        </article>
        <article class="b-card b-steps reveal">
          <p class="b-k">How one is made</p>
          <ol>
            <li><span>You</span>“A widget for the release checklist.”</li>
            <li><span>Agent</span><code>hive plugins new widget release</code> writes a starter and its <code>PROMPT.md</code>.</li>
            <li><span>Agent</span>Fills it in, installs it, and updates it as the work moves.</li>
          </ol>
          <a href={link('guide/widgets/')}>Make a widget</a>
        </article>
        {widgets.map((w) => (
          <article class="b-card b-widget reveal">
            <img src={link(`shots/showcase/${w.id}.webp`)} width={w.w} height={w.h} loading="lazy" decoding="async" alt={`The ${w.name} widget.`} />
            <p class="b-name"><span>Widget</span>{w.name}</p>
          </article>
        ))}
      </div>
      <p class="after center">Widgets and views get no files and no network. <a href={HIVEHUB}>Browse the plugins on HiveHub</a></p>
    </div>
  </section>

  <section class="band" id="api" aria-labelledby="api-h">
    <div class="wrap split rev">
      <div class="head reveal">
        <h2 id="api-h">Everything you can click, an agent can call.</h2>
        <p class="sub"><code>hive ctl</code> is on every agent's PATH, so agents start agents, read their replies and open tools. Your own scripts get the same API, with a token you can take back.</p>
        <ul class="ticks">
          <li>Agents run agents: fan out, pipe, gather.</li>
          <li>Tokens by role: view, edit, terminals, agents.</li>
          <li>SDKs for TypeScript and Python ship with the app.</li>
        </ul>
        <p class="links-row"><a href={link('guide/agent-workflows/')}>Agents running agents</a><a href={link('guide/api/')}>The API</a></p>
      </div>
      <div class="codebox reveal" data-code>
        <div class="code-tabs" role="tablist" aria-label="Ways to drive a workspace">
          <button type="button" role="tab" aria-selected="true" data-c="ctl">hive ctl</button>
          <button type="button" role="tab" aria-selected="false" data-c="ts">TypeScript</button>
          <button type="button" role="tab" aria-selected="false" data-c="py">Python</button>
        </div>
        {Object.entries(code).map(([k, lines], i) => (
          <pre class="code" data-pane={k} hidden={i !== 0}>{lines.map(([kind, text]) => (
            <span class={`l ${kind}`}>{kind === 'p' && <span class="pr">$ </span>}{text}{'\n'}</span>
          ))}</pre>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="reach" aria-labelledby="reach-h">
    <div class="wrap">
      <div class="head reveal center">
        <h2 id="reach-h">Your machines. Your phone. Your people.</h2>
        <p class="sub">Every hop is a machine you run. No server of ours sits in the path.</p>
      </div>
      <div class="reach">
        <article class="r-card r-phone reveal">
          <div class="phone"><img src={link('shots/phone-home.webp')} width="780" height="1688" loading="lazy" decoding="async"
            alt="The phone page's Home: a permission card for Editing Nav.tsx with Allow and Deny, above a list of agents." /></div>
          <div class="r-copy">
            <h3>On your phone</h3>
            <p>Follow your agents and answer them from your phone's browser, through a <code>hive-net</code> server of yours.</p>
            <a href={link('guide/phone/')}>Set up the phone page</a>
          </div>
        </article>
        <article class="r-card reveal">
          <h3>On your other machines</h3>
          <p>Open a folder on a Linux box over your own ssh. Its terminals and agents run there.</p>
          <pre class="mini"><span class="pr">$ </span>hive machine add dev@build-box --install</pre>
          <a href={link('guide/machines/')}>Add a machine</a>
        </article>
        <article class="r-card reveal">
          <h3>With someone else</h3>
          <p>Send an invite link. If both screens show the same three words, you choose what they may do.</p>
          <pre class="mini"><span class="pr">$ </span>hive share ~/work/api --role edit --expires 2d</pre>
          <a href={link('guide/multiplayer/')}>Share a workspace</a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" id="agents" aria-labelledby="agents-h">
    <div class="wrap">
      <div class="head reveal center">
        <h2 id="agents-h">Every coding agent, even the one that ships tomorrow.</h2>
        <p class="sub">Install its CLI and it is on the board. For one Hivemind has never seen, your agent reads its <code>--help</code> and writes the file that teaches Hivemind to run it.</p>
      </div>
      <ul class="dock reveal" aria-label="Agents Hivemind finds on its own">
        {agents.map((a) => (
          <li title={a.label}>
            {a.icon
              ? <svg viewBox={a.icon.viewBox} width="22" height="22" fill="currentColor" fill-rule={a.icon.fillRule as any} aria-hidden="true">{a.icon.paths.map((d) => <path d={d} />)}</svg>
              : <span class="mono-mark" aria-hidden="true">{a.label.slice(0, 1)}</span>}
            <span class="d-name">{a.label}</span>
          </li>
        ))}
        <li class="d-next"><a href={link('guide/agent-providers/')}><span class="mono-mark" aria-hidden="true">+</span><span class="d-name">Yours</span></a></li>
      </ul>
    </div>
  </section>

  <section class="band" id="numbers" aria-labelledby="numbers-h">
    <div class="wrap">
      <div class="head reveal">
        <h2 id="numbers-h">Fast with many agents, measured under load.</h2>
        <p class="sub">From the <a href={changelog}>2026.10.3 changelog</a>, on 16 CPUs, with the load each ran under.</p>
      </div>
      <dl class="nums reveal">
        <div><dt>3–7 ms</dt><dd>Key echo while another terminal prints 10 MB. It was 162 ms.</dd></div>
        <div><dt>0.23 ms</dt><dd>Cost of one agent event, the same with 72 or 600 agents. It was 1.9 ms.</dd></div>
        <div><dt>10 ms</dt><dd>Your phone's agent list for 600 agents. It was 1.6 s.</dd></div>
      </dl>
    </div>
  </section>

  <section class="band" id="faq" aria-labelledby="faq-h">
    <div class="wrap faq-wrap">
      <h2 id="faq-h" class="reveal">Questions</h2>
      <div class="faq">
        {faq.map(({ q, a }) => <details><summary>{q}</summary><p set:html={a} /></details>)}
      </div>
    </div>
  </section>

  <section class="band dl" id="download" aria-labelledby="download-h">
    <div class="wrap">
      <div class="dl-head reveal">
        <h2 id="download-h">Start with one repo.</h2>
        <p class="sub">One command installs the app and the <code>hive</code> CLI.</p>
      </div>
      <div class="dl-box" data-os="linux">
        <div class="dl-os" role="tablist" aria-label="Your computer">
          <button type="button" role="tab" data-pick="linux" aria-selected="true">Linux</button>
          <button type="button" role="tab" data-pick="macos" aria-selected="false">macOS</button>
          <button type="button" role="tab" data-pick="windows" aria-selected="false">Windows</button>
        </div>
        <div class="install"><code data-cmd>{install}</code>
          <button class="copy" type="button" data-copy={install} data-install aria-label="Copy the install command">Copy</button></div>
        <p class="dl-file" data-for="linux">x86_64. <a href={dl('linux')}>Or take the AppImage</a></p>
        <p class="dl-file" data-for="macos">Apple Silicon. <a href={dl('macos')}>Or take the .app</a></p>
        <p class="dl-file" data-for="windows">x64, in PowerShell. Run least so far.</p>
      </div>
      <p class="dl-more">CLI only: <a href={dl('cli-linux-x86_64')}>Linux x86_64</a>, <a href={dl('cli-linux-arm64')}>Linux arm64</a>, <a href={dl('cli-macos-arm64')}>macOS</a>, <a href={dl('cli-windows-x64')}>Windows</a>. <a href={dl('notes')}>Release notes</a>. <a href={link('guide/getting-started/')}>Quickstart</a>.</p>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <span>Hivemind, MIT licensed.</span>
      <nav aria-label="Footer">
        <a href={link('guide/')}>Docs</a>
        <a href={link('guide/install/')}>Install</a>
        <a href={link('guide/run-many-agents/')}>Run many agents</a>
        <a href={link('guide/faq/')}>FAQ</a>
        <a href={link('guide/cli/')}>CLI reference</a>
        <a href={HIVEHUB}>HiveHub</a>
        <a href={link('guide/docs-for-agents/')}>For agents</a>
        <a href={repo}>GitHub</a>
      </nav>
    </div>
    <p class="wordmark" aria-hidden="true">Hivemind</p>
  </div>
</footer>

<script is:inline define:vars={{ INSTALL: install, INSTALL_PS: installPs }}>
  // This computer's card goes first and the hero button names it; a wrong guess costs nothing.
  (() => {
    const ua = navigator.userAgent;
    const handheld = /iPhone|iPad|iPod|Android/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    const os = handheld ? null : /Windows|Win32|Win64/.test(ua) ? 'windows' : /Mac OS X|Macintosh/.test(ua) ? 'macos' : /Linux|X11|CrOS/.test(ua) ? 'linux' : null;
    const name = { windows: 'Windows', macos: 'macOS', linux: 'Linux' }[os];
    const btn = document.querySelector('[data-dl-label]');
    if (btn && name) btn.textContent = `Download for ${name}`;
    // Hivemind runs on a computer: on a phone the button sends this page there.
    if (btn && handheld) {
      btn.textContent = 'Send to my computer';
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const url = location.origin + location.pathname;
        try {
          if (navigator.share) await navigator.share({ title: 'Hivemind', text: 'Install Hivemind on this computer.', url });
          else { await navigator.clipboard.writeText(url); btn.textContent = 'Link copied'; }
        } catch { /* share closed */ }
      });
    }
    // One install box: it opens on this computer's system, and the switch changes every install command on the page.
    const box = document.querySelector('.dl-box');
    const cmds = { linux: INSTALL, macos: INSTALL, windows: INSTALL_PS };
    const pick = (to) => {
      box.dataset.os = to;
      box.querySelectorAll('[data-pick]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.pick === to)));
      box.querySelector('[data-cmd]').textContent = cmds[to];
      document.querySelectorAll('[data-install]').forEach((b) => { b.dataset.copy = cmds[to]; });
    };
    box?.querySelectorAll('[data-pick]').forEach((b) => b.addEventListener('click', () => pick(b.dataset.pick)));
    if (box && os) pick(os);
  })();
  document.querySelectorAll(".copy, .copy-cmd").forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy);
        const was = b.textContent;
        b.textContent = b.dataset.label || 'Copied'; b.dataset.done = '';
        setTimeout(() => { b.textContent = was; delete b.dataset.done; }, 1600);
      } catch { /* clipboard blocked: the command is still selectable */ }
    });
  });
</script>

<script>
  // Views: a fanned stack of real views; a tab brings one forward, and it turns on its own while in sight.
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  const vtabs = [...document.querySelectorAll<HTMLButtonElement>('.vtabs [role="tab"]')];
  if (fan && vtabs.length) {
    const cards = [...fan.querySelectorAll<HTMLElement>('.fan-card')];
    let at = 0, auto = true, timer = 0;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (i: number) => {
      at = i;
      cards.forEach((c, j) => { c.dataset.pos = String((j - i + cards.length) % cards.length); });
      vtabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)));
    };
    vtabs.forEach((t, i) => t.addEventListener('click', () => { auto = false; go(i); }));
    cards.forEach((c, i) => c.addEventListener('click', () => { auto = false; go(i); }));
    if (!still) new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting) timer = window.setInterval(() => { if (auto) go((at + 1) % cards.length); }, 3200);
    }, { threshold: 0.4 }).observe(fan);
  }
  // Code: three ways to say the same thing.
  const box = document.querySelector<HTMLElement>('[data-code]');
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-c]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      box.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== t.dataset.c; });
    }));
  }
</script>

<style is:global>
  :root{
    --f:"Geist","Geist Fallback",ui-sans-serif,system-ui,-apple-system,sans-serif;
    --f-m:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
    --ease-move:cubic-bezier(0.77,0,0.175,1);
    --glow:oklch(0.62 0.05 250);
    --gut:32px;
    color-scheme:dark;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth;scroll-padding-top:72px;scrollbar-color:var(--line2) var(--bg);overflow-x:clip}
  body{margin:0;background:var(--bg);color:var(--fg2);font-family:var(--f);font-size:16px;line-height:1.6;
    -webkit-font-smoothing:antialiased;overflow-x:clip}
  a{color:inherit;text-underline-offset:3px;text-decoration-thickness:1px}
  ::selection{background:color-mix(in oklab,var(--fg) 25%,transparent);color:var(--fg)}
  :focus-visible{outline:2px solid var(--fg2);outline-offset:3px;border-radius:3px}
  .skip{position:absolute;left:16px;top:-60px;background:var(--fg);color:var(--bg);padding:10px 14px;z-index:200;border-radius:5px}
  .skip:focus{top:12px}
  .wrap{max-width:1240px;margin:0 auto;padding:0 var(--gut)}

  h1,h2,h3{color:var(--fg);margin:0;text-wrap:balance}
  h1{font-size:clamp(42px,6.4vw,92px);line-height:.98;letter-spacing:-.045em;font-weight:700;max-width:14ch}
  h2{font-size:clamp(32px,4.4vw,60px);line-height:1.02;letter-spacing:-.04em;font-weight:700;max-width:17ch}
  h3{font-size:19px;line-height:1.3;letter-spacing:-.015em;font-weight:600}
  p{margin:0}
  code,.code,.mini{font-family:var(--f-m)}
  :not(pre)>code{font-size:.88em;color:var(--fg);white-space:nowrap}
  .sub{font-size:18px;line-height:1.55;color:var(--fg3);max-width:52ch;margin-top:20px;text-wrap:pretty}
  .sub a,.after a,.dl-more a,.links-row a,.r-card a,.b-steps a{color:var(--fg);text-decoration:underline;text-decoration-color:var(--line2)}
  @media (hover:hover) and (pointer:fine){
    .sub a:hover,.after a:hover,.dl-more a:hover,.links-row a:hover,.r-card a:hover,.b-steps a:hover{text-decoration-color:var(--fg2)}
  }

  .nav{position:sticky;top:0;z-index:50;background:color-mix(in oklab,var(--bg) 82%,transparent);
    backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);border-bottom:1px solid var(--line)}
  .nav-in{max-width:1240px;margin:0 auto;padding:0 var(--gut);height:56px;display:flex;align-items:center;gap:24px}
  .brand{display:flex;align-items:center;gap:9px;font-weight:600;font-size:15px;color:var(--fg);text-decoration:none;letter-spacing:-.01em}
  .links{display:flex;gap:22px;margin-left:auto;font-size:14px}
  .links a{color:var(--fg3);text-decoration:none;transition:color .15s ease}
  @media (hover:hover) and (pointer:fine){ .links a:hover{color:var(--fg)} }

  .btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 20px;
    border-radius:8px;font-size:15px;font-weight:600;text-decoration:none;border:1px solid transparent;white-space:nowrap;
    transition-property:background-color,border-color,transform,box-shadow;transition-duration:.15s;transition-timing-function:ease}
  .btn.small{height:32px;padding:0 13px;font-size:13px;font-weight:500;border-color:var(--line2);color:var(--fg);border-radius:6px}
  .btn:active{transform:scale(.97)}
  .btn.primary{background:var(--fg);color:var(--bg);box-shadow:0 0 0 1px oklch(1 0 0 / .1),0 8px 28px -6px oklch(0.93 0.004 250 / .35)}
  @media (hover:hover) and (pointer:fine){
    .btn.primary:hover{background:oklch(1 0 0);box-shadow:0 0 0 1px oklch(1 0 0 / .2),0 10px 36px -6px oklch(0.93 0.004 250 / .5)}
    .btn.small:hover{border-color:var(--fg3)}
  }

  .install{display:flex;align-items:center;gap:12px;min-width:0;height:44px;padding:0 6px 0 14px;
    background:var(--bg2);border:1px solid var(--line2);border-radius:8px;font-size:13px}
  .install code{font-size:13px;color:var(--fg2);white-space:nowrap;overflow-x:auto;scrollbar-width:none;min-width:0}
  .install code::-webkit-scrollbar{display:none}
  .install code::before{content:"$ ";color:var(--fg3)}
  .copy{margin-left:auto;flex-shrink:0;font:500 12px/1 var(--f-m);cursor:pointer;color:var(--fg3);background:transparent;
    border:1px solid var(--line2);border-radius:5px;padding:8px 10px;transition:color .15s ease,border-color .15s ease}
  .copy[data-done]{color:var(--st-done);border-color:color-mix(in oklab,var(--st-done) 45%,transparent)}
  @media (hover:hover) and (pointer:fine){ .copy:hover{color:var(--fg);border-color:var(--fg3)} }

  /* Hero: one sentence, the command, and the real app under it, already in the first screen. */
  .hero{position:relative;isolation:isolate;padding:56px 0 96px;overflow:clip}
  /* The app's canvas grid behind the hero, fading toward the edges, a few of its cells lit, and one
     soft light under the picture. Static, so scrolling never repaints it. */
  .hero-bg{position:absolute;inset:0;z-index:-1;pointer-events:none;--cell:24px;
    background:radial-gradient(ellipse 58% 34% at 50% 56%,color-mix(in oklab,var(--glow) 30%,transparent),transparent 72%)}
  .hero-bg::before{content:"";position:absolute;inset:0;
    background:radial-gradient(circle at center,color-mix(in oklab,var(--fg) 14%,transparent) 1px,transparent 1.5px) 50% 0/var(--cell) var(--cell);
    -webkit-mask-image:radial-gradient(ellipse 75% 85% at 50% 35%,#000 30%,transparent 78%);mask-image:radial-gradient(ellipse 75% 85% at 50% 35%,#000 30%,transparent 78%)}
  .hero-bg i{position:absolute;left:calc(50% + var(--x) * var(--cell) - var(--cell) / 2);top:calc(var(--y) * var(--cell));width:var(--cell);height:var(--cell);
    background:color-mix(in oklab,var(--fg) 5%,transparent);box-shadow:inset 0 0 0 1px color-mix(in oklab,var(--fg) 4%,transparent)}
  .hero-copy{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 64px;align-items:start;margin:0 0 40px}
  .hero h1{font-size:clamp(40px,4.5vw,66px);letter-spacing:-.04em;max-width:15ch}
  .hero h1 span{color:var(--fg3)}
  .lede{font-size:clamp(17px,1.3vw,19px);line-height:1.5;color:var(--fg2);max-width:44ch;text-wrap:pretty}
  .hero-act{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
  .btn.ghost{border-color:var(--line2);color:var(--fg);font-weight:500;background:transparent}
  .btn.ghost[data-done]{color:var(--st-done);border-color:color-mix(in oklab,var(--st-done) 45%,transparent)}
  @media (hover:hover) and (pointer:fine){.btn.ghost:hover{border-color:var(--fg3)}}
  @media (prefers-reduced-motion:no-preference){
    .hero-say>*,.hero-do>*{animation:rise .55s cubic-bezier(.16,1,.3,1) backwards}
    .hero-do>:nth-child(1){animation-delay:.1s}
    .hero-do>:nth-child(n+2){animation-delay:.15s}
    @keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  }
  @media (max-width:1000px){
    .hero-copy{grid-template-columns:minmax(0,1fr)}
  }

  .band{padding:136px 0;border-top:1px solid var(--line);position:relative}
  .head{margin-bottom:56px}
  .center{text-align:center}
  .head.center{display:grid;justify-items:center}
  .head.center .sub{margin-inline:auto}
  .after{margin-top:32px;font-size:15px;color:var(--fg3)}
  .links-row{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:28px;font-size:15px}
  .split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.2fr);gap:64px;align-items:center}
  .split.rev{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}
  .split .head{margin:0}
  .split.views{grid-template-columns:minmax(0,.72fr) minmax(0,1.45fr)}

  /* Scroll reveals: visible by default; only browsers that can tie them to scroll animate. */
  @supports (animation-timeline: view()){
    @media (prefers-reduced-motion:no-preference){
      .reveal{animation:reveal linear both;animation-timeline:view();animation-range:entry 0% entry 55%}
      @keyframes reveal{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
    }
  }

  /* Views: a fanned stack in depth. */
  .vtabs{display:grid;gap:4px;margin-top:32px}
  .vtabs button{display:grid;gap:2px;text-align:left;font:inherit;background:transparent;border:0;border-left:2px solid var(--line);
    padding:10px 0 10px 16px;cursor:pointer;color:var(--fg3);transition:border-color .2s,color .2s}
  .vtabs b{font-weight:600;color:var(--fg2);font-size:16px}
  .vtabs span{font-size:14.5px}
  .vtabs [aria-selected="true"]{border-left-color:var(--fg)}
  .vtabs [aria-selected="true"] b{color:var(--fg)}
  @media (hover:hover) and (pointer:fine){.vtabs button:hover b{color:var(--fg)}}
  .fan{position:relative;aspect-ratio:16/11.5;perspective:1600px}
  .fan::before{content:"";position:absolute;inset:-10%;background:radial-gradient(50% 45% at 50% 50%,oklch(0.62 0.05 250 / .22),transparent 70%);pointer-events:none}
  .fan-card{position:absolute;left:1%;top:20%;width:86%;margin:0;border-radius:12px;overflow:hidden;cursor:pointer;
    border:1px solid var(--line2);background:var(--term);box-shadow:var(--sh3);transform-origin:50% 100%;
    transition:transform .8s var(--ease)}
  .fan-card::after{content:"";position:absolute;inset:0;background:#000;opacity:0;pointer-events:none;transition:opacity .6s var(--ease)}
  .fan-card img{display:block;width:100%;height:auto}
  .fan-card figcaption{position:absolute;left:0;right:0;bottom:0;display:flex;gap:10px;align-items:baseline;font:500 13px/1.2 var(--f);
    color:var(--fg);padding:28px 16px 14px;background:linear-gradient(to top,oklch(0.14 0.004 250 / .92),transparent)}
  .fan-card figcaption span{color:var(--fg3);font-size:12.5px;font-weight:400}
  .fan-card[data-pos="0"]{z-index:4;transform:rotateX(6deg) rotateY(-12deg)}
  .fan-card[data-pos="1"]{z-index:3;transform:rotateX(6deg) rotateY(-12deg) translate3d(6%,-9%,-110px)}
  .fan-card[data-pos="2"]{z-index:2;transform:rotateX(6deg) rotateY(-12deg) translate3d(12%,-18%,-220px)}
  .fan-card[data-pos="3"]{z-index:1;transform:rotateX(6deg) rotateY(-12deg) translate3d(18%,-27%,-330px)}
  .fan-card[data-pos="1"]::after{opacity:.4}
  .fan-card[data-pos="2"]::after{opacity:.58}
  .fan-card[data-pos="3"]::after{opacity:.72}

  /* Widgets and tools: a bento of the real things. */
  .bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  .b-card{position:relative;border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,var(--bg2),var(--bg));overflow:hidden;min-width:0}
  .b-tool{grid-column:span 3;display:grid;grid-template-rows:1fr auto;background:var(--term)}
  .b-tool img{display:block;width:100%;height:100%;object-fit:cover;object-position:top left}
  .b-copy{padding:18px 22px;border-top:1px solid var(--line);display:flex;gap:16px;align-items:baseline;color:var(--fg2)}
  .b-k{font:500 11px/1 var(--f-m);letter-spacing:.1em;text-transform:uppercase;color:var(--fg3);flex:none}
  .b-steps{grid-row:span 2;padding:24px;display:grid;align-content:start;gap:18px}
  .b-steps ol{list-style:none;margin:0;padding:0;display:grid;gap:16px;counter-reset:s}
  .b-steps li{display:grid;gap:4px;color:var(--fg);font-size:15px;line-height:1.45;padding-left:28px;position:relative;counter-increment:s}
  .b-steps li::before{content:counter(s);position:absolute;left:0;top:1px;width:19px;height:19px;border-radius:50%;
    border:1px solid var(--line2);font:500 11px/17px var(--f-m);text-align:center;color:var(--fg3)}
  .b-steps li span{font:500 11px/1 var(--f-m);letter-spacing:.08em;text-transform:uppercase;color:var(--fg3)}
  .b-steps li code{white-space:normal}
  .b-steps a{font-size:14px;margin-top:auto}
  .b-widget{display:grid;place-items:center;padding:18px 18px 44px;aspect-ratio:1/1}
  .b-widget img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;border-radius:10px}
  .b-name{position:absolute;left:16px;bottom:14px;font-size:13.5px;color:var(--fg);display:flex;gap:8px;align-items:baseline}
  .b-name span{font:500 11px/1 var(--f-m);letter-spacing:.1em;text-transform:uppercase;color:var(--fg3)}
  @media (hover:hover) and (pointer:fine){
    .b-card{transition:border-color .2s,transform .3s var(--ease)}
    .b-card:hover{border-color:var(--line2);transform:translateY(-2px)}
  }

  /* Agents and API */
  .ticks{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:10px;color:var(--fg2);font-size:15.5px}
  .ticks li{padding-left:24px;position:relative}
  .ticks li::before{content:"";position:absolute;left:2px;top:.55em;width:8px;height:8px;border-radius:2px;background:var(--fg3)}
  .codebox{border:1px solid var(--line2);border-radius:14px;background:var(--term);box-shadow:var(--sh3),0 30px 90px -30px oklch(0.62 0.05 250 / .35);overflow:hidden;min-width:0}
  .code-tabs{display:flex;gap:2px;padding:8px;border-bottom:1px solid var(--line);background:var(--bg2)}
  .code-tabs button{font:500 12.5px/1 var(--f-m);color:var(--fg3);background:transparent;border:1px solid transparent;border-radius:6px;padding:8px 12px;cursor:pointer}
  .code-tabs [aria-selected="true"]{color:var(--fg);background:var(--bg3);border-color:var(--line2)}
  .code{margin:0;padding:22px 24px 26px;font-size:13.5px;line-height:1.85;color:var(--fg2);overflow-x:auto;white-space:pre}
  .code .c{color:var(--fg3)} .code .k{color:var(--fg)} .code .pr{color:var(--fg3)} .code .p{color:var(--fg)}

  /* Anywhere */
  .reach{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .r-card{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,var(--bg2),var(--bg));padding:28px;display:grid;gap:12px;align-content:start;color:var(--fg3);min-width:0}
  .r-card p{max-width:46ch}
  .r-card a{font-size:14.5px;justify-self:start}
  .r-phone{grid-row:span 2;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);align-items:center;gap:28px;padding:28px 28px 0}
  .r-copy{display:grid;gap:12px;align-content:center;padding-bottom:28px}
  .phone{align-self:end;border:6px solid oklch(0.26 0.005 250);border-bottom:0;border-radius:34px 34px 0 0;overflow:hidden;
    box-shadow:0 -20px 60px -20px oklch(0.62 0.05 250 / .35);max-height:420px}
  .phone img{display:block;width:100%;height:auto}
  .mini{margin:4px 0 0;font-size:12.5px;line-height:1.6;color:var(--fg);background:var(--term);border:1px solid var(--line);
    border-radius:8px;padding:12px 14px;white-space:pre;overflow-x:auto;min-width:0}
  .mini .pr{color:var(--fg3)}

  /* Agents: a dock of the marks the app draws. */
  .dock{list-style:none;margin:0 auto;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px;max-width:980px}
  .dock li,.dock .d-next a{display:inline-flex;align-items:center;gap:10px;padding:8px 14px 8px 0;color:var(--fg);font-size:14.5px;text-decoration:none}
  .dock .d-next{padding:0}
  .dock .d-next a{color:var(--fg2);text-decoration:underline;text-decoration-color:var(--line2);text-underline-offset:4px}
  .mono-mark{width:22px;height:22px;display:grid;place-items:center;border:1px solid var(--line2);border-radius:5px;font:500 11px/1 var(--f-m);color:var(--fg)}
  @media (hover:hover) and (pointer:fine){ .dock .d-next a:hover{color:var(--fg);text-decoration-color:var(--fg3)} }

  /* Numbers */
  .nums{margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line2)}
  .nums div{padding:32px 32px 0 0}
  .nums div+div{padding-left:32px;border-left:1px solid var(--line)}
  .nums dt{font:500 clamp(40px,4.6vw,64px)/1 var(--f-m);letter-spacing:-.04em;color:var(--fg);font-variant-numeric:tabular-nums}
  .nums dd{margin:16px 0 0;color:var(--fg3);font-size:15.5px;max-width:30ch}

  .faq-wrap{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:48px;align-items:start}
  .faq details{border-top:1px solid var(--line);padding:4px 0}
  .faq details:last-child{border-bottom:1px solid var(--line)}
  .faq summary{cursor:pointer;list-style:none;padding:18px 32px 18px 0;color:var(--fg);font-size:18px;font-weight:500;position:relative}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";position:absolute;right:4px;top:16px;font:400 22px/1 var(--f-m);color:var(--fg3);transition:transform .2s var(--ease)}
  .faq details[open] summary::after{transform:rotate(45deg)}
  .faq details p{padding:0 0 20px;color:var(--fg3);max-width:62ch}

  .dl{background:radial-gradient(60% 70% at 50% 0%,oklch(0.62 0.05 250 / .16),transparent 70%)}
  .dl-head{display:grid;justify-items:center;text-align:center;margin-bottom:48px}
  .dl-head h2{font-size:clamp(40px,6vw,84px);max-width:none}
  .dl-box{max-width:720px;margin:0 auto 24px;border:1px solid var(--line2);border-radius:14px;padding:20px;background:var(--bg2);
    box-shadow:0 20px 60px -30px oklch(0.62 0.05 250 / .5);display:grid;gap:14px}
  .dl-os{display:flex;gap:4px;justify-self:center;padding:4px;border:1px solid var(--line);border-radius:10px;background:var(--bg)}
  .dl-os button{font:500 14px/1 var(--f);color:var(--fg3);background:transparent;border:0;border-radius:7px;padding:10px 16px;cursor:pointer;min-height:40px}
  .dl-os [aria-selected="true"]{color:var(--fg);background:var(--bg3)}
  @media (hover:hover) and (pointer:fine){.dl-os button:hover{color:var(--fg)}}
  .dl-box .install code{white-space:nowrap;overflow-x:auto;scrollbar-width:none}
  .dl-file{margin:0;font-size:13.5px;color:var(--fg3);text-align:center}
  .dl-file a{color:var(--fg2)}
  .dl-box:not([data-os="linux"]) [data-for="linux"],.dl-box:not([data-os="macos"]) [data-for="macos"],.dl-box:not([data-os="windows"]) [data-for="windows"]{display:none}
  .dl-more,.dl .sub{color:var(--fg2)}
  .dl-more{font-size:14px;text-align:center}

  .foot{border-top:1px solid var(--line);padding:28px 0 0;font-size:14px;color:var(--fg3);overflow:hidden}
  .foot-in{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;justify-content:space-between}
  .foot nav{display:flex;flex-wrap:wrap;gap:8px 22px}
  .foot a{color:var(--fg2);text-decoration:none}
  @media (hover:hover) and (pointer:fine){ .foot a:hover{color:var(--fg)} }
  .wordmark{font-weight:800;font-size:clamp(72px,19vw,280px);line-height:.8;letter-spacing:-.06em;text-align:center;margin:56px 0 -.12em;
    color:oklch(0.93 0.004 250 / .07);user-select:none}

  @media (max-width:960px){
    .split,.split.rev,.split.views,.faq-wrap{grid-template-columns:minmax(0,1fr);gap:40px}
    .bento{grid-template-columns:repeat(2,minmax(0,1fr))}
    .b-tool{grid-column:1 / -1;grid-row:auto}
    .b-steps{grid-column:1 / -1;grid-row:auto}
    .reach{grid-template-columns:minmax(0,1fr)}
    .r-phone{grid-row:auto}
    .nums{grid-template-columns:minmax(0,1fr)}
    .nums div,.nums div+div{padding:24px 0;border-left:0;border-bottom:1px solid var(--line)}
  }
  @media (max-width:640px){
    :root{--gut:16px}
    /* Phones: a solid bar; blurring what scrolls under it costs every frame. */
    .nav{background:color-mix(in oklab,var(--bg) 96%,transparent);backdrop-filter:none;-webkit-backdrop-filter:none}
    .nav-in{height:auto;min-height:52px;padding:8px var(--gut);flex-wrap:wrap;gap:6px 14px}
    .links{order:3;width:100%;margin:0 calc(var(--gut) * -1);padding:0 var(--gut);overflow-x:auto;gap:18px;scrollbar-width:none}
    .links::-webkit-scrollbar{display:none}
    .links a{white-space:nowrap;padding:6px 0}
    .nav-in > .btn{margin-left:auto}
    .hero{padding:28px 0 64px}
    .hero-copy{margin-bottom:28px;gap:18px}
    .hero-act .copy-cmd{display:none}
    .hero-act{margin-top:20px}
    .hero-act .btn{flex:1 1 auto}
    .band{padding:88px 0}
    .head{margin-bottom:36px}
    .sub{font-size:16.5px}
    .fan{aspect-ratio:16/12.5}
    .fan-card{width:90%;left:2%}
    /* Phones: the same stack, flat, so the cards are not held as layers in depth while it turns. */
    .fan{perspective:none}
    .fan-card[data-pos="0"]{transform:none}
    .fan-card[data-pos="1"]{transform:translate(3%,-8%) scale(.955)}
    .fan-card[data-pos="2"]{transform:translate(6%,-16%) scale(.91)}
    .fan-card[data-pos="3"]{transform:translate(9%,-24%) scale(.865)}
    .vtabs span{display:none}
    .b-copy{flex-direction:column;gap:8px}
    .r-phone{grid-template-columns:minmax(0,1fr);padding:24px 24px 0}
    .r-phone .phone{order:2;max-width:240px;justify-self:center;max-height:300px}
    .r-copy{padding-bottom:0}
    .r-card{padding:24px}
    .code{font-size:12px;padding:18px}
    .dock li,.dock .d-next a{font-size:13px;padding:6px 10px 6px 0}
    .links-row a,.r-card a,.b-steps>a{display:inline-block;padding:6px 0;margin:-6px 0}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *{transition-duration:1ms !important}
    .btn:active{transform:none}
  }
</style>
</body>
</html>
