{
  // The phone app's TypeScript, checked by crates/hive-web/build.sh, which compiles each module into
  // js/ for tests; the page loads esbuild's bundle.
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["app/*.ts"]
}
