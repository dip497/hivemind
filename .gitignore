# Per-developer / local dev artifacts — never committed.
# Ignore .claude/ contents (settings.local.json, agents, local skills) but SHIP
# the skills that are part of the product / the contribution process, not local cruft:
# hive-browser backs the Browser tile; adding-an-agent-provider is the procedure a
# contributor (or their agent) follows to wire a new CLI agent end to end.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/hive-browser/
!.claude/skills/adding-an-agent-provider/
.hyperresearch/
research/
